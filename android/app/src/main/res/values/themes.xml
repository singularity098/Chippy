<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, without a title bar, the window the colour of Chippy's
         background so nothing flashes while it starts. -->
    <style name="Theme.Chippy" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/chippy_bg</item>
        <item name="android:statusBarColor">@color/chippy_bg</item>
        <item name="android:navigationBarColor">@color/chippy_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <color name="chippy_bg">#15151a</color>
    <color name="chippy_icon_bg">#0d1020</color>
</resources>
