// Modal dialogs over the whole window (a track's properties, exporting the
// playlist to audio files), and the panels that slide up over the player
// with the playing track's lyrics and guitar tab, the bottom bar left in
// view below them.
import { Fling } from "fling.slint";
import { Theme } from "theme.slint";
import { IconButton, BigButton, Chip, SettingRow, Stepper, MenuItem, PlayButton, Tip } from "widgets.slint";
import { Icon, Icons } from "icons.slint";
import { InfoField } from "types.slint";
import { Now } from "nowplaying.slint";
import { ScrollView } from "std-widgets.slint";

export global Info {
    in property <bool> shown;
    in property <string> title;
    in property <[InfoField]> fields;
    // Every field as text, for "Copy all".
    in property <string> all-text;
    callback close;
}

// A line of tab: where it starts (for its label) and its notes.
export struct TabCell {
    // Across the line, 0..1.
    x: float,
    // 0 is the lowest string.
    string: int,
    fret: string,
}

// A bar across a line of tab: from x0 to x1 (0..1), with its bar line at
// x0 if it starts on this line.
export struct TabBar {
    x0: float,
    x1: float,
    index: int,
    line: bool,
    // Its number, "12".
    label: string,
    // Chosen, to nudge along the neck on its own.
    selected: bool,
    // Nudged on its own.
    nudged: bool,
}

export struct TabLine {
    start: string,
    cells: [TabCell],
    bars: [TabBar],
}

export global Lyrics {
    in property <bool> shown;
    in property <string> title;
    // "From Song.lrc", "From the file's tags".
    in property <string> source;
    in property <[string]> lines;
    // When each line is sung, "[1:23]" ("" for untimed lyrics).
    in property <[string]> times;
    // The lines are timed: the current one is marked and kept in view.
    in property <bool> synced;
    in property <int> current: -1;
    // Shown instead of lines when there are none.
    in property <string> message;
    in property <string> all-text;
    callback close;
    // Jumps to a timed line.
    callback seek-line(int);
}

export global Tabs {
    in property <bool> shown;
    in property <string> title;
    // Working out the notes.
    in property <bool> busy;
    // Shown instead of the tab (why there is none).
    in property <string> message;
    // The pitched parts ("Pulse 1 · Square lead") and the one shown.
    in property <[string]> part-names;
    in property <int> part;
    // The instruments and tunings, and the one used.
    in property <[string]> tunings;
    in property <int> tuning;
    // String names, lowest first.
    in property <[string]> strings;
    in property <[TabLine]> lines;
    in property <int> current: -1;
    // Where playback is across the current line, 0..1.
    in property <float> playhead;
    // "Moved down an octave to fit."
    in property <string> detail;
    in property <string> all-text;
    // Moved by hand, for this track and part (until the app closes): by
    // octaves, and by steps along the neck; and whether it can go further.
    in property <int> octave;
    in property <int> position;
    in property <bool> can-up;
    in property <bool> can-down;
    // Something to put back (the part, or the chosen bars).
    in property <bool> adjusted;
    // The bars chosen to nudge on their own: "Bar 12", "Bars 3–5"; "".
    in property <string> selection;
    // The bars: "4/4, ♩ = 120 · guessed from the notes"; the time
    // signatures to choose from ("As found" first) and the one used; the
    // beat made faster or slower (powers of two); and whether any of it
    // was changed by hand.
    in property <bool> has-bars;
    in property <string> meter-text;
    in property <[string]> sigs;
    in property <int> sig;
    in property <int> speed;
    in property <bool> meter-adjusted;
    callback close;
    callback shift-octave(int);
    callback nudge(int);
    callback reset-adjust;
    callback step-part(int);
    callback set-part(int);
    callback set-tuning(int);
    callback seek-line(int);
    // A click on a bar chooses it (with Shift, the bars up to it); a
    // double-click plays from it.
    callback select-bar(int, bool);
    callback seek-bar(int);
    callback set-sig(int);
    callback step-speed(int);
    callback shift-bars(int);
    callback reset-meter;
    // Saves the tab as MusicXML or Guitar Pro.
    callback save;
    // How many fret numbers fit across a line, as the panel is sized.
    callback set-width(int);
}

export global Export {
    in property <bool> shown;
    // "24 tracks" or the one track's title.
    in property <string> what;
    // 0 WAV, 1 FLAC, 2 MP3, 3 Opus; the notes: 4 MIDI, 5 MusicXML, 6
    // Guitar Pro.
    in property <int> format;
    // Some track's notes can be found (else the notes are greyed out).
    in property <bool> midi-ok: true;
    // "MIDI: 3 of 12 tracks" and the like, when only some can.
    in property <string> midi-note;
    in property <string> format-detail;
    // kbps, for MP3 and Opus.
    in property <int> bitrate;
    in property <string> folder;
    in property <bool> running;
    in property <float> progress;
    in property <string> status;
    callback set-format(int);
    callback step-bitrate(int);
    callback choose-folder;
    callback start;
    callback cancel;
    callback close;
}

// A dimmed backdrop and a card in the middle; a click beside the card or
// Esc closes it.
component Modal inherits Rectangle {
    in property <length> card-width: 560px;
    in property <length> card-height: 480px;
    in property <string> heading;
    in property <string> icon;
    in property <bool> closable: true;
    callback close;
    background: #000000a0;
    TouchArea {
        clicked => { if root.closable { root.close(); } }
    }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape && root.closable { root.close(); return accept; }
            reject
        }
    }
    card := Rectangle {
        width: min(root.card-width, root.width - 32px);
        height: min(root.card-height, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.popup;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000c0;
        // Clicks on the card stay on it.
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            padding-top: 10px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                height: 44px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    line: root.icon;
                    weight: 1.6;
                    tint: Theme.paint;
                }
                Text {
                    text: root.heading;
                    font-size: Theme.font-large;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    opacity: root.closable ? 1 : 0;
                    enabled: root.closable;
                    icon: Icons.close;
                    tip: "Close (Esc)";
                    clicked => { if root.closable { root.close(); } }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            @children
        }
    }
}

export component InfoDialog inherits Modal {
    heading: Info.title;
    icon: Icons.info-line;
    card-width: 640px;
    card-height: 620px;
    close => { Info.close(); }
    Fling {
        vertical-stretch: 1;
        offset <=> scroll.viewport-y;
        range: scroll.viewport-height - scroll.visible-height;
        scroll := ScrollView {
            VerticalLayout {
                spacing: 2px;
                for f in Info.fields: HorizontalLayout {
                    spacing: 14px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    Text {
                        width: 150px;
                        text: f.label;
                        color: Theme.text-dim;
                        font-size: Theme.font-small;
                        font-weight: Theme.regular;
                        horizontal-alignment: right;
                        wrap: word-wrap;
                    }
                    // Selectable, to copy a value.
                    TextInput {
                        horizontal-stretch: 1;
                        text: f.value;
                        read-only: true;
                        color: Theme.text;
                        selection-background-color: Theme.paint;
                        wrap: word-wrap;
                        single-line: false;
                    }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        // Holds the text that "Copy all" puts on the clipboard.
        copier := TextInput {
            width: 0px;
            height: 0px;
            opacity: 0;
            read-only: true;
            text: Info.all-text;
        }
        BigButton {
            text: "Copy all";
            tip: "Copy every field as text";
            clicked => { copier.select-all(); copier.copy(); copier.clear-selection(); }
        }
        BigButton {
            text: "Close";
            primary: true;
            clicked => { Info.close(); }
        }
    }
}

export component ExportDialog inherits Modal {
    heading: "Export " + Export.what;
    icon: Icons.export-line;
    card-width: 600px;
    card-height: 530px;
    closable: !Export.running;
    close => { Export.close(); }
    VerticalLayout {
        spacing: 12px;
        vertical-stretch: 1;
        SettingRow {
            label: "Sound";
            detail: Export.format < 4 ? Export.format-detail : "Or the sound itself.";
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                for name[i] in ["WAV", "FLAC", "MP3", "Opus"]: Chip {
                    text: name;
                    selected: i == Export.format;
                    clicked => { if !Export.running { Export.set-format(i); } }
                }
            }
        }
        SettingRow {
            label: "Notes";
            detail: Export.format >= 4 ? Export.format-detail : "Or the notes: MIDI, sheet music or tab.";
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                for name[i] in ["MIDI", "MusicXML", "Guitar Pro"]: Chip {
                    text: name;
                    selected: i + 4 == Export.format;
                    enabled: Export.midi-ok;
                    tip: !Export.midi-ok ? "The notes of these tracks can't be found" : "";
                    clicked => { if !Export.running { Export.set-format(i + 4); } }
                }
            }
        }
        if Export.format == 2 || Export.format == 3: SettingRow {
            label: "Bitrate";
            detail: Export.format == 2 ? "Constant bitrate." : "Variable bitrate; 128 kbps is transparent for most music.";
            Stepper {
                text: Export.bitrate + " kbps";
                tip: "Change the bitrate";
                step(d) => { if !Export.running { Export.step-bitrate(d); } }
            }
        }
        SettingRow {
            label: "Folder";
            detail: Export.folder == "" ? "Choose where the files go." : Export.folder;
            BigButton {
                y: (parent.height - self.height) / 2;
                min-width: 140px;
                text: "Choose…";
                icon-line: Icons.folder-line;
                enabled: !Export.running;
                clicked => { Export.choose-folder(); }
            }
        }
        Text {
            text: Export.format == 4
                ? "One file per track, named by track number and title. The notes are worked out from what the tune does to its sound chip, or from a module's patterns, one MIDI track per channel, with instruments guessed from the samples, in bars (as the file has them, or worked out from the notes). MIDI files are copied as they are." + (Export.midi-note == "" ? "" : " " + Export.midi-note)
                : Export.format > 4
                ? "One file per track, named by track number and title: each pitched part as tab in bars, on a guitar (or a bass, if it is low), its times rounded to sixteenths and triplets. The track shown in the guitar tab goes as it is shown there: its instrument, its bars and its fingering as you moved them." + (Export.midi-note == "" ? "" : " " + Export.midi-note)
                : "One file per track, named by track number and title, with its tags. Looping chiptunes end as they do when played: at their length, with the fade.";
            color: Theme.text-faint;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        // Always there (shown or not by opacity): elements made and removed
        // while the export runs upset the renderer.
        Rectangle {
            height: 30px;
            opacity: Export.running || Export.status != "" ? 1 : 0;
            VerticalLayout {
            spacing: 6px;
            Text {
                text: Export.status;
                color: Theme.text-dim;
                font-size: Theme.font-small;
                overflow: elide;
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.surface-2;
                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, Export.progress));
                    border-radius: 3px;
                    background: Theme.paint;
                }
            }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        BigButton {
            text: Export.running ? "Cancel" : "Close";
            clicked => { if Export.running { Export.cancel(); } else { Export.close(); } }
        }
        BigButton {
            text: "Export";
            icon-line: Icons.export-line;
            primary: true;
            enabled: !Export.running && Export.folder != "";
            clicked => { Export.start(); }
        }
    }
}

// The lyrics and guitar tab panels stay up while the track plays: Space
// still pauses and plays; Esc puts the panel away.
component PlayerKeys inherits FocusScope {
    callback close;
    key-pressed(e) => {
        if e.text == Key.Escape { root.close(); return accept; }
        if e.text == " " { Now.play-pause(); return accept; }
        reject
    }
}

// A choice from a list: the one chosen, and the list to pick from below
// it. Its width is set by where it is, not by what it says, so whatever is
// beside it stays put.
component Dropdown inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <length> list-width: 300px;
    callback picked(int);
    preferred-width: 140px;
    min-width: 60px;
    height: 34px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.pressed : Theme.surface-3;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? Theme.border-hover : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.45;
    Text {
        x: 12px;
        width: parent.width - 42px;
        height: parent.height;
        text: root.current >= 0 && root.current < root.items.length ? root.items[root.current] : "–";
        color: Theme.accent;
        font-weight: Theme.regular;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        line: Icons.chevron-down;
        weight: 2;
        tint: Theme.text-dim;
    }
    touch := TouchArea {
        enabled: root.enabled && root.items.length > 0;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { list.show(); }
    }
    Tip { text: root.tip; hover: touch.has-hover && !touch.pressed; pressed: touch.pressed; }
    list := PopupWindow {
        // Closed by the pick itself: a click inside reaches the item first.
        close-policy: close-on-click-outside;
        x: 0;
        y: root.height + 4px;
        width: max(root.width, root.list-width);
        height: min(root.items.length * 36px + 14px, 400px);
        Rectangle {
            background: Theme.popup;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000a0;
            ScrollView {
                VerticalLayout {
                    padding: 6px;
                    for item[i] in root.items: MenuItem {
                        text: item;
                        checkable: true;
                        checked: i == root.current;
                        // Picked before closing: closing ends the list.
                        clicked => {
                            root.picked(i);
                            list.close();
                        }
                    }
                }
            }
        }
    }
}

// A panel over the player, from the top of the bottom bar up: its heading,
// a button that puts it away (as does dragging its top down), and what it
// shows.
component Sheet inherits Rectangle {
    in property <string> heading;
    in property <string> icon;
    // Up (it takes the keyboard when it comes up).
    in property <bool> open;
    // No bottom bar below it (a phone held upright): play and pause here.
    in property <bool> compact;
    callback close;
    background: Theme.bg;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000c0;
    changed open => {
        if root.open { keys.focus(); }
    }
    // Clicks on the panel stay on it.
    TouchArea { }
    keys := PlayerKeys {
        width: 0;
        height: 0;
        close => { root.close(); }
    }
    // Dragging the top of the panel down puts it away.
    TouchArea {
        y: 0;
        height: 64px;
        moved => {
            if self.pressed && self.mouse-y - self.pressed-y > 48px { root.close(); }
        }
    }
    VerticalLayout {
        padding: 16px;
        padding-top: 0;
        spacing: 8px;
        // The grip.
        Rectangle {
            height: 12px;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 5px;
                width: 40px;
                height: 4px;
                border-radius: 2px;
                background: Theme.border-strong;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            height: 40px;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                line: root.icon;
                weight: 1.6;
                tint: Theme.paint;
            }
            Text {
                text: root.heading;
                font-size: Theme.font-large;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.compact: PlayButton {
                y: (parent.height - self.height) / 2;
                size: 40px;
                playing: Now.state == 1;
                tip: Now.state == 1 ? "Pause (Space)" : "Play (Space)";
                clicked => { Now.play-pause(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.chevron-down;
                tip: "Put away (Esc)";
                clicked => { root.close(); }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        @children
    }
}

export component LyricsSheet inherits Sheet {
    heading: Lyrics.title;
    icon: Icons.lyrics-line;
    open: Lyrics.shown;
    close => { Lyrics.close(); }
    property <length> line-h: 44px;
    // Keeps the line being sung a third of the way down. (Followed through
    // the line number: a binding on the scroll's own size would loop.)
    property <int> cur: Lyrics.current;
    changed cur => {
        if Lyrics.synced && root.cur >= 0 {
            scroll.viewport-y = -max(0, min(root.cur * root.line-h - scroll.visible-height / 3, Lyrics.lines.length * root.line-h - scroll.visible-height));
        }
    }
    Rectangle {
        vertical-stretch: 1;
        scroll := ScrollView {
            animate viewport-y { duration: 280ms; easing: ease-out; }
            VerticalLayout {
                for line[i] in Lyrics.lines: Rectangle {
                    height: root.line-h;
                    property <bool> now: Lyrics.synced && i == Lyrics.current;
                    border-radius: 8px;
                    background: touch.has-hover && Lyrics.synced ? Theme.surface-2 : transparent;
                    property <string> time: i < Lyrics.times.length ? Lyrics.times[i] : "";
                    stamp := Text {
                        x: 12px;
                        width: self.text == "" ? 0 : 52px;
                        text: parent.time;
                        vertical-alignment: center;
                        font-size: Theme.font-small - 1px;
                        font-weight: Theme.regular;
                        color: Theme.text-faint.transparentize(45%);
                    }
                    Text {
                        x: 12px + stamp.width;
                        width: parent.width - 24px - stamp.width;
                        text: line;
                        wrap: word-wrap;
                        overflow: elide;
                        vertical-alignment: center;
                        font-size: parent.now ? Theme.font-large : Theme.font;
                        font-weight: parent.now ? Theme.regular : Theme.light;
                        color: parent.now ? Theme.paint : (Lyrics.synced && i < Lyrics.current ? Theme.text-faint : Theme.text);
                        animate font-size, color { duration: 180ms; }
                    }
                    touch := TouchArea {
                        enabled: Lyrics.synced;
                        mouse-cursor: Lyrics.synced ? pointer : default;
                        clicked => { Lyrics.seek-line(i); }
                    }
                }
            }
        }
        if Lyrics.lines.length == 0: Text {
            x: 24px;
            width: parent.width - 48px;
            height: parent.height;
            text: Lyrics.message;
            color: Theme.text-dim;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: Lyrics.source;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        copier := TextInput {
            width: 0px;
            height: 0px;
            opacity: 0;
            read-only: true;
            text: Lyrics.all-text;
        }
        if Lyrics.lines.length > 0: BigButton {
            text: "Copy";
            tip: "Copy the lyrics as text";
            clicked => { copier.select-all(); copier.copy(); copier.clear-selection(); }
        }
    }
}

// Moving the tab by hand: an octave up or down, and the fingering up or
// down the neck; back to how it was.
component TabAdjust inherits HorizontalLayout {
    in property <bool> enabled;
    spacing: 4px;
    horizontal-stretch: 0;
    Text {
        horizontal-stretch: 0;
        text: "Octave";
        color: Theme.text-dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.minus;
        enabled: root.enabled && Tabs.octave > -3;
        tip: "Show it an octave lower";
        clicked => { Tabs.shift-octave(-1); }
    }
    Text {
        width: 22px;
        text: Tabs.octave > 0 ? "+" + Tabs.octave : Tabs.octave < 0 ? "−" + abs(Tabs.octave) : "0";
        color: Tabs.octave != 0 ? Theme.accent : Theme.text-faint;
        font-size: Theme.font-small;
        font-weight: Theme.regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.plus;
        enabled: root.enabled && Tabs.octave < 3;
        tip: "Show it an octave higher";
        clicked => { Tabs.shift-octave(1); }
    }
    Rectangle { width: 10px; }
    Text {
        horizontal-stretch: 0;
        text: Tabs.selection == "" ? "Neck" : Tabs.selection;
        color: Tabs.selection == "" ? Theme.text-dim : Theme.accent;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.chevron-left;
        enabled: root.enabled && Tabs.can-down;
        tip: Tabs.selection == "" ? "Move the shapes down the neck, towards the nut" : "Move these bars' shapes down the neck, towards the nut";
        clicked => { Tabs.nudge(-1); }
    }
    Text {
        width: 22px;
        text: Tabs.position > 0 ? "+" + Tabs.position : Tabs.position < 0 ? "−" + abs(Tabs.position) : "0";
        color: Tabs.position != 0 ? Theme.accent : Theme.text-faint;
        font-size: Theme.font-small;
        font-weight: Theme.regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.chevron-right;
        enabled: root.enabled && Tabs.can-up;
        tip: Tabs.selection == "" ? "Move the shapes up the neck, to higher frets" : "Move these bars' shapes up the neck, to higher frets";
        clicked => { Tabs.nudge(1); }
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.refresh-line;
        enabled: root.enabled && Tabs.adjusted;
        tip: Tabs.selection == "" ? "Back to how it fits best" : "These bars back to how they fit best";
        clicked => { Tabs.reset-adjust(); }
    }
}

// Where the bars fall, put right by hand: the time signature, the beat
// twice as fast or half as fast, and the bar lines a beat earlier or later.
component TabBars inherits HorizontalLayout {
    in property <bool> enabled;
    spacing: 4px;
    Text {
        horizontal-stretch: 0;
        text: "Bars";
        color: Theme.text-dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    Dropdown {
        width: 124px;
        list-width: 140px;
        items: Tabs.sigs;
        current: Tabs.sig;
        enabled: root.enabled;
        tip: "The time signature";
        picked(i) => { Tabs.set-sig(i); }
    }
    Rectangle { width: 6px; }
    Text {
        horizontal-stretch: 0;
        text: "Speed";
        color: Theme.text-dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.minus;
        enabled: root.enabled && Tabs.speed > -2;
        tip: "Half as many beats, each twice as long";
        clicked => { Tabs.step-speed(-1); }
    }
    Text {
        width: 26px;
        text: Tabs.speed == 0 ? "×1" : Tabs.speed == 1 ? "×2" : Tabs.speed == 2 ? "×4" : Tabs.speed == -1 ? "½" : "¼";
        color: Tabs.speed != 0 ? Theme.accent : Theme.text-faint;
        font-size: Theme.font-small;
        font-weight: Theme.regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.plus;
        enabled: root.enabled && Tabs.speed < 2;
        tip: "Twice as many beats, each half as long";
        clicked => { Tabs.step-speed(1); }
    }
    Rectangle { width: 6px; }
    Text {
        horizontal-stretch: 0;
        text: "Bar lines";
        color: Theme.text-dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.chevron-left;
        enabled: root.enabled;
        tip: "The bar lines a beat earlier";
        clicked => { Tabs.shift-bars(-1); }
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.chevron-right;
        enabled: root.enabled;
        tip: "The bar lines a beat later";
        clicked => { Tabs.shift-bars(1); }
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.refresh-line;
        enabled: root.enabled && Tabs.meter-adjusted;
        tip: "The bars back as found";
        clicked => { Tabs.reset-meter(); }
    }
    Rectangle { width: 6px; }
    Text {
        horizontal-stretch: 1;
        text: Tabs.meter-text;
        color: Theme.text-faint;
        font-size: Theme.font-small;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component TabsSheet inherits Sheet {
    heading: Tabs.title;
    icon: Icons.guitar-line;
    open: Tabs.shown;
    close => { Tabs.close(); }
    property <length> gap: 15px;
    // A line: its time on top, clear of the numbers on the top string.
    property <length> line-height: (Tabs.strings.length - 1) * root.gap + 48px;
    property <length> label-width: 26px;
    property <length> left: root.label-width + 6px;
    // Across a line, for the notes: what the scroll shows, less the
    // names of the strings and room for its bar.
    property <length> span: max(100px, scroll.visible-width - root.left - 18px);
    // A fret number and its padding, the unit the lines are laid out in
    // (a two-digit number takes two).
    property <length> digit: 11px;
    property <int> digits: floor(root.span / root.digit);
    changed digits => { Tabs.set-width(root.digits); }
    init => { Tabs.set-width(root.digits); }
    property <int> cur: Tabs.current;
    changed cur => {
        if root.cur >= 0 {
            scroll.viewport-y = -max(0, min(root.cur * root.line-height - scroll.visible-height / 4, Tabs.lines.length * root.line-height - scroll.visible-height));
        }
    }
    HorizontalLayout {
        spacing: 8px;
        height: 34px;
        Text {
            text: "Part";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.chevron-left;
            enabled: Tabs.part-names.length > 1 && !Tabs.busy;
            tip: "The previous part (channel)";
            clicked => { Tabs.step-part(-1); }
        }
        Dropdown {
            horizontal-stretch: 3;
            items: Tabs.part-names;
            current: Tabs.part;
            enabled: Tabs.part-names.length > 1 && !Tabs.busy;
            tip: "Show another part (channel)";
            picked(i) => { Tabs.set-part(i); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.chevron-right;
            enabled: Tabs.part-names.length > 1 && !Tabs.busy;
            tip: "The next part (channel)";
            clicked => { Tabs.step-part(1); }
        }
        Rectangle { width: 8px; }
        Text {
            text: "For";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        Dropdown {
            horizontal-stretch: 2;
            items: Tabs.tunings;
            current: Tabs.tuning;
            enabled: !Tabs.busy && Tabs.part-names.length > 0;
            tip: "Another instrument or tuning";
            picked(i) => { Tabs.set-tuning(i); }
        }
        if !root.compact: Rectangle { width: 8px; }
        if !root.compact: TabAdjust {
            enabled: !Tabs.busy && Tabs.lines.length > 0;
        }
    }
    if root.compact: TabAdjust {
        height: 34px;
        alignment: center;
        enabled: !Tabs.busy && Tabs.lines.length > 0;
    }
    if Tabs.has-bars: TabBars {
        height: 34px;
        enabled: !Tabs.busy && Tabs.lines.length > 0;
    }
    Rectangle {
        vertical-stretch: 1;
        scroll := ScrollView {
            visible: !Tabs.busy;
            animate viewport-y { duration: 350ms; easing: ease-in-out; }
            VerticalLayout {
                for line[li] in Tabs.lines: row := Rectangle {
                    height: root.line-height;
                    property <bool> now: li == Tabs.current;
                    property <length> top: 28px;
                    border-radius: 8px;
                    background: self.now ? Theme.surface-2 : transparent;
                    Text {
                        x: root.left;
                        y: 2px;
                        text: line.start;
                        color: row.now ? Theme.accent : Theme.text-faint;
                        font-size: Theme.font-small - 1px;
                    }
                    // The strings, highest on top, with their names.
                    for name[si] in Tabs.strings: Rectangle {
                        property <length> sy: row.top + (Tabs.strings.length - 1 - si) * root.gap;
                        Text {
                            x: 4px;
                            y: parent.sy - self.height / 2;
                            width: root.label-width;
                            text: name;
                            color: Theme.text-faint;
                            font-size: Theme.font-small - 1px;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            x: root.left;
                            y: parent.sy;
                            width: root.span + 10px;
                            height: 1px;
                            background: Theme.border-strong;
                        }
                    }
                    Rectangle {
                        x: root.left;
                        y: row.top;
                        width: 2px;
                        height: (Tabs.strings.length - 1) * root.gap + 1px;
                        background: Theme.border-strong;
                    }
                    for c in line.cells: Rectangle {
                        x: root.left + c.x * root.digits * root.digit - self.width / 2;
                        y: row.top + (Tabs.strings.length - 1 - c.string) * root.gap - self.height / 2;
                        width: fret.preferred-width + 6px;
                        height: 15px;
                        background: row.now ? Theme.surface-2 : Theme.bg;
                        fret := Text {
                            text: c.fret;
                            color: Theme.text;
                            font-size: Theme.font-small;
                            font-weight: Theme.regular;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    // Bar lines, the bars' numbers, and the chosen bars
                    // marked above and below the strings.
                    for bar in line.bars: Rectangle {
                        property <length> x0: root.left + bar.x0 * root.digits * root.digit;
                        property <length> x1: root.left + bar.x1 * root.digits * root.digit;
                        if bar.line && bar.x0 > 0: Rectangle {
                            x: parent.x0 - 1px;
                            y: row.top;
                            width: 2px;
                            height: (Tabs.strings.length - 1) * root.gap + 1px;
                            background: Theme.text-faint;
                        }
                        Text {
                            x: parent.x0 + (bar.x0 > 0 ? 3px : 44px);
                            y: 3px;
                            text: bar.label;
                            color: bar.selected || bar.nudged ? Theme.accent : Theme.text-faint;
                            font-size: Theme.font-small - 2px;
                        }
                        if bar.selected: Rectangle {
                            x: parent.x0 + 2px;
                            y: row.top - 9px;
                            width: parent.x1 - parent.x0 - 4px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.paint;
                        }
                        if bar.selected: Rectangle {
                            x: parent.x0 + 2px;
                            y: row.top + (Tabs.strings.length - 1) * root.gap + 7px;
                            width: parent.x1 - parent.x0 - 4px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.paint;
                        }
                    }
                    if row.now: Rectangle {
                        x: root.left + Tabs.playhead * root.digits * root.digit - 1px;
                        y: row.top - 8px;
                        width: 2px;
                        height: (Tabs.strings.length - 1) * root.gap + 16px;
                        background: Theme.paint;
                        border-radius: 1px;
                    }
                    if line.bars.length == 0: TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Tabs.seek-line(li); }
                    }
                    for bar in line.bars: TouchArea {
                        property <bool> shift;
                        x: root.left + bar.x0 * root.digits * root.digit;
                        width: (bar.x1 - bar.x0) * root.digits * root.digit;
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                self.shift = e.modifiers.shift;
                            }
                        }
                        clicked => { Tabs.select-bar(bar.index, self.shift); }
                        double-clicked => { Tabs.seek-bar(bar.index); }
                    }
                }
            }
        }
        if Tabs.busy || Tabs.lines.length == 0: Text {
            x: 24px;
            width: parent.width - 48px;
            height: parent.height;
            text: Tabs.busy ? "Working out the notes…" : Tabs.message;
            color: Theme.text-dim;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: Tabs.detail;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
        copier := TextInput {
            width: 0px;
            height: 0px;
            opacity: 0;
            read-only: true;
            text: Tabs.all-text;
        }
        if Tabs.lines.length > 0: BigButton {
            text: "Copy";
            tip: "Copy the tab as text";
            clicked => { copier.select-all(); copier.copy(); copier.clear-selection(); }
        }
        if Tabs.lines.length > 0 && Tabs.has-bars: BigButton {
            text: "Save…";
            tip: "Save every part as tab in bars: MusicXML (sheet music and tab) or Guitar Pro";
            clicked => { Tabs.save(); }
        }
    }
}
