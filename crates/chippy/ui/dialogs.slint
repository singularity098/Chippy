// Modal dialogs over the whole window (a track's properties, exporting the
// playlist to audio files), and the panels that slide up over the player
// with the playing track's lyrics and guitar tab, the bottom bar left in
// view below them.
import { Fling } from "fling.slint";
import { Theme } from "theme.slint";
import { IconButton, BigButton, Chip, SettingRow, Stepper, MenuItem, PlayButton, Tip } from "widgets.slint";
import { Icon, Icons } from "icons.slint";
import { InfoField } from "types.slint";
import { Now } from "nowplaying.slint";
import { ScrollView } from "std-widgets.slint";

export global Info {
    in property <bool> shown;
    in property <string> title;
    in property <[InfoField]> fields;
    // Every field as text, for "Copy all".
    in property <string> all-text;
    callback close;
}

// A line of tab: where it starts (for its label) and its notes.
export struct TabCell {
    // Across the line, 0..1.
    x: float,
    // 0 is the lowest string.
    string: int,
    // "5", or "(5)" for a soft note.
    fret: string,
    // Played softer than the notes around it (an echo): drawn dimmer.
    soft: bool,
    // When its chord is played (ms), to play from it.
    ms: int,
    // The bar it is in (-1: no bars).
    bar: int,
}

// A note head on the staff (standard notation).
export struct StaffHead {
    // Across the line, 0..1: where the tab has its chord.
    x: float,
    // 0 the staff's bottom line, 1 the space above, 8 the top line; ledger
    // lines below 0 and above 8.
    pos: int,
    // 0 none, 1 sharp, 2 flat, 3 natural.
    accidental: int,
    // Beside the stem (a second): -1 left, 1 right.
    side: int,
    hollow: bool,
    dotted: bool,
    soft: bool,
}

// A chord on the staff: its stem (from its lowest head to its highest),
// flags, and when it is played.
export struct StaffStem {
    x: float,
    low: int,
    high: int,
    stem: bool,
    up: bool,
    flags: int,
    ms: int,
    bar: int,
}

// A bar across a line of tab: from x0 to x1 (0..1), with its bar line at
// x0 if it starts on this line.
export struct TabBar {
    x0: float,
    x1: float,
    index: int,
    line: bool,
    // Its number, "12".
    label: string,
    // Chosen, to nudge along the neck on its own.
    selected: bool,
    // Nudged on its own.
    nudged: bool,
}

// A row of the guitar tab's list of parts: what it is played on (an
// icon), whether it can be shown as tab (`pick`, its index among the parts
// shown, or -1 for the drums), and whether it is muted, soloed and heard.
export struct TabPart {
    name: string,
    // "Electric guitar", for the icon's tooltip.
    kind: string,
    icon-line: string,
    icon-solid: string,
    pick: int,
    muted: bool,
    soloed: bool,
    audible: bool,
}

// A note on the fretboard: playing now, or (dimmed) elsewhere in the bar.
export struct FretDot {
    // 0 is the lowest string.
    string: int,
    fret: int,
    // "Bb".
    name: string,
    now: bool,
}

export struct TabLine {
    start: string,
    cells: [TabCell],
    bars: [TabBar],
    heads: [StaffHead],
    stems: [StaffStem],
}

export global Lyrics {
    in property <bool> shown;
    in property <string> title;
    // "From Song.lrc", "From the file's tags".
    in property <string> source;
    in property <[string]> lines;
    // When each line is sung, "[1:23]" ("" for untimed lyrics).
    in property <[string]> times;
    // The lines are timed: the current one is marked and kept in view.
    in property <bool> synced;
    in property <int> current: -1;
    // Shown instead of lines when there are none.
    in property <string> message;
    in property <string> all-text;
    callback close;
    // Jumps to a timed line.
    callback seek-line(int);
}

export global Tabs {
    in property <bool> shown;
    in property <string> title;
    // Working out the notes.
    in property <bool> busy;
    // Shown instead of the tab (why there is none).
    in property <string> message;
    // The pitched parts ("Pulse 1 · Square lead") and the one shown.
    in property <[string]> part-names;
    in property <int> part;
    // The instruments and tunings, and the one used.
    in property <[string]> tunings;
    in property <int> tuning;
    // String names, lowest first.
    in property <[string]> strings;
    in property <[TabLine]> lines;
    in property <int> current: -1;
    // Where playback is across the current line, 0..1.
    in property <float> playhead;
    // "Moved down an octave to fit."
    in property <string> detail;
    in property <string> all-text;
    // Moved by hand, for this track and part (until the app closes): by
    // octaves, and by steps along the neck; and whether it can go further.
    in property <int> octave;
    in property <int> position;
    in property <bool> can-up;
    in property <bool> can-down;
    // Something to put back (the part, or the chosen bars).
    in property <bool> adjusted;
    // The bars chosen to nudge on their own: "Bar 12", "Bars 3–5"; "".
    in property <string> selection;
    // The bars: "4/4, ♩ = 120 · guessed from the notes"; the time
    // signatures to choose from ("As found" first) and the one used; the
    // beat made faster or slower (powers of two); and whether any of it
    // was changed by hand.
    in property <bool> has-bars;
    in property <string> meter-text;
    in property <[string]> sigs;
    in property <int> sig;
    in property <int> speed;
    in property <bool> meter-adjusted;
    callback close;
    callback shift-octave(int);
    callback nudge(int);
    callback reset-adjust;
    callback step-part(int);
    callback set-part(int);
    callback set-tuning(int);
    callback seek-line(int);
    // A click on a bar plays from its start, and on a note from the note;
    // Ctrl-click chooses the bar (to move it along the neck on its own),
    // Shift-click the bars up to it.
    callback select-bar(int, bool);
    callback seek-bar(int);
    callback seek-to(int);
    callback set-sig(int);
    callback step-speed(int);
    callback shift-bars(int);
    callback reset-meter;
    // Saves the tab as MusicXML or Guitar Pro.
    callback save;
    // How many fret numbers fit across a line, as the panel is sized.
    callback set-width(int);
    // How far the view is scrolled, in lines from the top (kept up to date
    // by the view, so the same bars stay in view when the part changes).
    in-out property <float> top-line;
    // Scroll to `keep-line` (lines from the top) when `keep` changes,
    // instead of following playback.
    in property <float> keep-line;
    in property <int> keep;
    // What the shown part can be merged with ("Pulse 2 · Square lead"),
    // and, if it is a merge, a way to take it apart; merge(i) does item i.
    in property <[string]> merge-items;
    callback merge(int);
    // Every part (those shown as tab, then the drums), to mute and solo.
    in property <[TabPart]> parts;
    // Muting is heard (the track plays through the SoundFont).
    in property <bool> can-mute;
    in property <bool> any-muted;
    callback toggle-mute(int);
    callback toggle-solo(int);
    callback clear-mutes;
    // The fretboard, under the controls (hidden at first): the strings'
    // names (lowest first), how many frets, and the notes of the bar
    // playing.
    in-out property <bool> fretboard-shown;
    in property <int> frets: 12;
    in property <[FretDot]> fret-dots;
    // What the lines show: 0 the tab, 1 standard notation, 2 both.
    in-out property <int> notation: 0;
    // The notation's clef: bass (else treble).
    in property <bool> bass-clef;
    // A tuning of the player's own, in use: its strings ("E2", lowest
    // first), and the tunings it can start from again. It is made from the
    // tunings' list ("Custom…"), then changed: every string a half step
    // up or down, one string, or a string more or fewer at either end.
    in property <bool> custom;
    in property <[string]> custom-strings;
    in property <[string]> custom-bases;
    in property <int> max-strings: 10;
    callback custom-from(int);
    callback custom-shift(int);
    callback custom-shift-string(int, int);
    callback custom-add(bool);
    callback custom-remove(bool);
}

export global Export {
    in property <bool> shown;
    // "24 tracks" or the one track's title.
    in property <string> what;
    // 0 WAV, 1 FLAC, 2 MP3, 3 Opus; the notes: 4 MIDI, 5 MusicXML, 6
    // Guitar Pro.
    in property <int> format;
    // Some track's notes can be found (else the notes are greyed out).
    in property <bool> midi-ok: true;
    // "MIDI: 3 of 12 tracks" and the like, when only some can.
    in property <string> midi-note;
    in property <string> format-detail;
    // kbps, for MP3 and Opus.
    in property <int> bitrate;
    in property <string> folder;
    in property <bool> running;
    in property <float> progress;
    in property <string> status;
    callback set-format(int);
    callback step-bitrate(int);
    callback choose-folder;
    callback start;
    callback cancel;
    callback close;
}

// A dimmed backdrop and a card in the middle; a click beside the card or
// Esc closes it.
component Modal inherits Rectangle {
    in property <length> card-width: 560px;
    in property <length> card-height: 480px;
    in property <string> heading;
    in property <string> icon;
    in property <bool> closable: true;
    callback close;
    background: #000000a0;
    TouchArea {
        clicked => { if root.closable { root.close(); } }
    }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape && root.closable { root.close(); return accept; }
            reject
        }
    }
    card := Rectangle {
        width: min(root.card-width, root.width - 32px);
        height: min(root.card-height, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.popup;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000c0;
        // Clicks on the card stay on it.
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            padding-top: 10px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                height: 44px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    line: root.icon;
                    weight: 1.6;
                    tint: Theme.paint;
                }
                Text {
                    text: root.heading;
                    font-size: Theme.font-large;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    opacity: root.closable ? 1 : 0;
                    enabled: root.closable;
                    icon: Icons.close;
                    tip: "Close (Esc)";
                    clicked => { if root.closable { root.close(); } }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            @children
        }
    }
}

export component InfoDialog inherits Modal {
    heading: Info.title;
    icon: Icons.info-line;
    card-width: 640px;
    card-height: 620px;
    close => { Info.close(); }
    Fling {
        vertical-stretch: 1;
        offset <=> scroll.viewport-y;
        range: scroll.viewport-height - scroll.visible-height;
        scroll := ScrollView {
            VerticalLayout {
                spacing: 2px;
                for f in Info.fields: HorizontalLayout {
                    spacing: 14px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    Text {
                        width: 150px;
                        text: f.label;
                        color: Theme.text-dim;
                        font-size: Theme.font-small;
                        font-weight: Theme.regular;
                        horizontal-alignment: right;
                        wrap: word-wrap;
                    }
                    // Selectable, to copy a value.
                    TextInput {
                        horizontal-stretch: 1;
                        text: f.value;
                        read-only: true;
                        color: Theme.text;
                        selection-background-color: Theme.paint;
                        wrap: word-wrap;
                        single-line: false;
                    }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        // Holds the text that "Copy all" puts on the clipboard.
        copier := TextInput {
            width: 0px;
            height: 0px;
            opacity: 0;
            read-only: true;
            text: Info.all-text;
        }
        BigButton {
            text: "Copy all";
            tip: "Copy every field as text";
            clicked => { copier.select-all(); copier.copy(); copier.clear-selection(); }
        }
        BigButton {
            text: "Close";
            primary: true;
            clicked => { Info.close(); }
        }
    }
}

export component ExportDialog inherits Modal {
    heading: "Export " + Export.what;
    icon: Icons.export-line;
    card-width: 600px;
    card-height: 530px;
    closable: !Export.running;
    close => { Export.close(); }
    VerticalLayout {
        spacing: 12px;
        vertical-stretch: 1;
        SettingRow {
            label: "Sound";
            detail: Export.format < 4 ? Export.format-detail : "Or the sound itself.";
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                for name[i] in ["WAV", "FLAC", "MP3", "Opus"]: Chip {
                    text: name;
                    selected: i == Export.format;
                    clicked => { if !Export.running { Export.set-format(i); } }
                }
            }
        }
        SettingRow {
            label: "Notes";
            detail: Export.format >= 4 ? Export.format-detail : "Or the notes: MIDI, sheet music or tab.";
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                for name[i] in ["MIDI", "MusicXML", "Guitar Pro"]: Chip {
                    text: name;
                    selected: i + 4 == Export.format;
                    enabled: Export.midi-ok;
                    tip: !Export.midi-ok ? "The notes of these tracks can't be found" : "";
                    clicked => { if !Export.running { Export.set-format(i + 4); } }
                }
            }
        }
        if Export.format == 2 || Export.format == 3: SettingRow {
            label: "Bitrate";
            detail: Export.format == 2 ? "Constant bitrate." : "Variable bitrate; 128 kbps is transparent for most music.";
            Stepper {
                text: Export.bitrate + " kbps";
                tip: "Change the bitrate";
                step(d) => { if !Export.running { Export.step-bitrate(d); } }
            }
        }
        SettingRow {
            label: "Folder";
            detail: Export.folder == "" ? "Choose where the files go." : Export.folder;
            BigButton {
                y: (parent.height - self.height) / 2;
                min-width: 140px;
                text: "Choose…";
                icon-line: Icons.folder-line;
                enabled: !Export.running;
                clicked => { Export.choose-folder(); }
            }
        }
        Text {
            text: Export.format == 4
                ? "One file per track, named by track number and title. The notes are worked out from what the tune does to its sound chip, or from a module's patterns, one MIDI track per channel, with instruments guessed from the samples, in bars (as the file has them, or worked out from the notes). MIDI files are copied as they are." + (Export.midi-note == "" ? "" : " " + Export.midi-note)
                : Export.format > 4
                ? "One file per track, named by track number and title: each pitched part as tab in bars, on a guitar (or a bass, if it is low), its times rounded to sixteenths and triplets. The track shown in the guitar tab goes as it is shown there: its instrument, its bars and its fingering as you moved them." + (Export.midi-note == "" ? "" : " " + Export.midi-note)
                : "One file per track, named by track number and title, with its tags. Looping chiptunes end as they do when played: at their length, with the fade.";
            color: Theme.text-faint;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        // Always there (shown or not by opacity): elements made and removed
        // while the export runs upset the renderer.
        Rectangle {
            height: 30px;
            opacity: Export.running || Export.status != "" ? 1 : 0;
            VerticalLayout {
            spacing: 6px;
            Text {
                text: Export.status;
                color: Theme.text-dim;
                font-size: Theme.font-small;
                overflow: elide;
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.surface-2;
                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, Export.progress));
                    border-radius: 3px;
                    background: Theme.paint;
                }
            }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        BigButton {
            text: Export.running ? "Cancel" : "Close";
            clicked => { if Export.running { Export.cancel(); } else { Export.close(); } }
        }
        BigButton {
            text: "Export";
            icon-line: Icons.export-line;
            primary: true;
            enabled: !Export.running && Export.folder != "";
            clicked => { Export.start(); }
        }
    }
}

// The lyrics and guitar tab panels stay up while the track plays: Space
// still pauses and plays; Esc puts the panel away.
component PlayerKeys inherits FocusScope {
    callback close;
    key-pressed(e) => {
        if e.text == Key.Escape { root.close(); return accept; }
        if e.text == " " { Now.play-pause(); return accept; }
        reject
    }
}

// A choice from a list: the one chosen, and the list to pick from below
// it. Its width is set by where it is, not by what it says, so whatever is
// beside it stays put.
component Dropdown inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <length> list-width: 300px;
    // Shown when nothing is chosen.
    in property <string> placeholder: "–";
    callback picked(int);
    preferred-width: 140px;
    min-width: 60px;
    height: 34px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.pressed : Theme.surface-3;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? Theme.border-hover : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.45;
    Text {
        x: 12px;
        width: parent.width - 42px;
        height: parent.height;
        text: root.current >= 0 && root.current < root.items.length ? root.items[root.current] : root.placeholder;
        color: root.current >= 0 && root.current < root.items.length ? Theme.accent : Theme.text-dim;
        font-weight: Theme.regular;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        line: Icons.chevron-down;
        weight: 2;
        tint: Theme.text-dim;
    }
    touch := TouchArea {
        enabled: root.enabled && root.items.length > 0;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { list.show(); }
    }
    Tip { text: root.tip; hover: touch.has-hover && !touch.pressed; pressed: touch.pressed; }
    list := PopupWindow {
        // Closed by the pick itself: a click inside reaches the item first.
        close-policy: close-on-click-outside;
        x: 0;
        y: root.height + 4px;
        width: max(root.width, root.list-width);
        height: min(root.items.length * 36px + 14px, 400px);
        Rectangle {
            background: Theme.popup;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000a0;
            ScrollView {
                VerticalLayout {
                    padding: 6px;
                    for item[i] in root.items: MenuItem {
                        text: item;
                        checkable: true;
                        checked: i == root.current;
                        // Picked before closing: closing ends the list.
                        clicked => {
                            root.picked(i);
                            list.close();
                        }
                    }
                }
            }
        }
    }
}

// A panel over the player, from the top of the bottom bar up: its heading,
// a button that puts it away (as does dragging its top down), and what it
// shows. On the desktop it is a page instead (`page`): it takes the
// player's place, flat on the window, with no grip or shadow. Or a card
// under the album art (`docked`), the player still in use beside it: it
// leaves the keyboard to the player.
component Sheet inherits Rectangle {
    in property <string> heading;
    in property <string> icon;
    // Up (it takes the keyboard when it comes up).
    in property <bool> open;
    // No bottom bar below it (a phone held upright): play and pause here.
    in property <bool> compact;
    // In the player's place, not over it.
    in property <bool> page;
    // A card under the album art.
    in property <bool> docked;
    callback close;
    property <bool> flat: root.page || root.docked;
    background: root.docked ? Theme.surface : root.page ? transparent : Theme.bg;
    border-top-left-radius: root.docked ? Theme.radius + 4px : root.page ? 0 : 16px;
    border-top-right-radius: root.docked ? Theme.radius + 4px : root.page ? 0 : 16px;
    border-bottom-left-radius: root.docked ? Theme.radius + 4px : 0;
    border-bottom-right-radius: root.docked ? Theme.radius + 4px : 0;
    border-width: root.page ? 0 : 1px;
    border-color: root.docked ? Theme.border : Theme.border-strong;
    drop-shadow-blur: root.flat ? 0 : 24px;
    drop-shadow-color: root.flat ? transparent : #000000c0;
    clip: root.docked;
    changed open => {
        if root.open && !root.docked { keys.focus(); }
    }
    // Clicks on the panel stay on it.
    TouchArea { }
    keys := PlayerKeys {
        width: 0;
        height: 0;
        close => { root.close(); }
    }
    // Dragging the top of the panel down puts it away.
    if !root.flat: TouchArea {
        y: 0;
        height: 64px;
        moved => {
            if self.pressed && self.mouse-y - self.pressed-y > 48px { root.close(); }
        }
    }
    VerticalLayout {
        padding: 16px;
        padding-top: root.flat ? 12px : 0;
        padding-left: root.docked ? 12px : 16px;
        padding-right: root.docked ? 8px : 16px;
        padding-bottom: root.docked ? 10px : 16px;
        spacing: root.docked ? 6px : 8px;
        // The grip.
        if !root.flat: Rectangle {
            height: 12px;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 5px;
                width: 40px;
                height: 4px;
                border-radius: 2px;
                background: Theme.border-strong;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            height: 40px;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                line: root.icon;
                weight: 1.6;
                tint: Theme.paint;
            }
            Text {
                text: root.heading;
                font-size: root.docked ? Theme.font + 1px : Theme.font-large;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.compact: PlayButton {
                y: (parent.height - self.height) / 2;
                size: 40px;
                playing: Now.state == 1;
                tip: Now.state == 1 ? "Pause (Space)" : "Play (Space)";
                clicked => { Now.play-pause(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: root.page ? Icons.close : Icons.chevron-down;
                tip: root.docked ? "Collapse (L)" : root.page ? "Back to the player (Esc)" : "Put away (Esc)";
                clicked => { root.close(); }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        @children
    }
}

export component LyricsSheet inherits Sheet {
    heading: Lyrics.title;
    icon: Icons.lyrics-line;
    open: Lyrics.shown;
    close => { Lyrics.close(); }
    property <length> line-h: 44px;
    // Keeps the line being sung a third of the way down. (Followed through
    // the line number: a binding on the scroll's own size would loop.)
    property <int> cur: Lyrics.current;
    changed cur => {
        if Lyrics.synced && root.cur >= 0 {
            scroll.viewport-y = -max(0, min(root.cur * root.line-h - scroll.visible-height / 3, Lyrics.lines.length * root.line-h - scroll.visible-height));
        }
    }
    Rectangle {
        vertical-stretch: 1;
        scroll := ScrollView {
            animate viewport-y { duration: 280ms; easing: ease-out; }
            VerticalLayout {
                for line[i] in Lyrics.lines: Rectangle {
                    height: root.line-h;
                    property <bool> now: Lyrics.synced && i == Lyrics.current;
                    border-radius: 8px;
                    background: touch.has-hover && Lyrics.synced ? Theme.surface-2 : transparent;
                    property <string> time: i < Lyrics.times.length ? Lyrics.times[i] : "";
                    stamp := Text {
                        x: 12px;
                        width: self.text == "" ? 0 : 52px;
                        text: parent.time;
                        vertical-alignment: center;
                        font-size: Theme.font-small - 1px;
                        font-weight: Theme.regular;
                        color: Theme.text-faint.transparentize(45%);
                    }
                    Text {
                        x: 12px + stamp.width;
                        width: parent.width - 24px - stamp.width;
                        text: line;
                        wrap: word-wrap;
                        overflow: elide;
                        vertical-alignment: center;
                        font-size: parent.now ? Theme.font-large : Theme.font;
                        font-weight: parent.now ? Theme.regular : Theme.light;
                        color: parent.now ? Theme.paint : (Lyrics.synced && i < Lyrics.current ? Theme.text-faint : Theme.text);
                        animate font-size, color { duration: 180ms; }
                    }
                    touch := TouchArea {
                        enabled: Lyrics.synced;
                        mouse-cursor: Lyrics.synced ? pointer : default;
                        clicked => { Lyrics.seek-line(i); }
                    }
                }
            }
        }
        if Lyrics.lines.length == 0: Text {
            x: 24px;
            width: parent.width - 48px;
            height: parent.height;
            text: Lyrics.message;
            color: Theme.text-dim;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: Lyrics.source;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        copier := TextInput {
            width: 0px;
            height: 0px;
            opacity: 0;
            read-only: true;
            text: Lyrics.all-text;
        }
        if Lyrics.lines.length > 0: BigButton {
            text: "Copy";
            tip: "Copy the lyrics as text";
            clicked => { copier.select-all(); copier.copy(); copier.clear-selection(); }
        }
    }
}

// Moving the tab by hand: an octave up or down, and the fingering up or
// down the neck; back to how it was.
component TabAdjust inherits HorizontalLayout {
    in property <bool> enabled;
    spacing: 4px;
    horizontal-stretch: 0;
    Text {
        horizontal-stretch: 0;
        text: "Octave";
        color: Theme.text-dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.minus;
        enabled: root.enabled && Tabs.octave > -3;
        tip: "Show it an octave lower";
        clicked => { Tabs.shift-octave(-1); }
    }
    Text {
        width: 22px;
        text: Tabs.octave > 0 ? "+" + Tabs.octave : Tabs.octave < 0 ? "−" + abs(Tabs.octave) : "0";
        color: Tabs.octave != 0 ? Theme.accent : Theme.text-faint;
        font-size: Theme.font-small;
        font-weight: Theme.regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.plus;
        enabled: root.enabled && Tabs.octave < 3;
        tip: "Show it an octave higher";
        clicked => { Tabs.shift-octave(1); }
    }
    Rectangle { width: 10px; }
    Text {
        horizontal-stretch: 0;
        text: Tabs.selection == "" ? "Neck" : Tabs.selection;
        color: Tabs.selection == "" ? Theme.text-dim : Theme.accent;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.chevron-left;
        enabled: root.enabled && Tabs.can-down;
        tip: Tabs.selection == "" ? "Move the shapes down the neck, towards the nut (Ctrl-click a bar to move it alone)" : "Move these bars' shapes down the neck, towards the nut";
        clicked => { Tabs.nudge(-1); }
    }
    Text {
        width: 22px;
        text: Tabs.position > 0 ? "+" + Tabs.position : Tabs.position < 0 ? "−" + abs(Tabs.position) : "0";
        color: Tabs.position != 0 ? Theme.accent : Theme.text-faint;
        font-size: Theme.font-small;
        font-weight: Theme.regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.chevron-right;
        enabled: root.enabled && Tabs.can-up;
        tip: Tabs.selection == "" ? "Move the shapes up the neck, to higher frets (Ctrl-click a bar to move it alone)" : "Move these bars' shapes up the neck, to higher frets";
        clicked => { Tabs.nudge(1); }
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.refresh-line;
        enabled: root.enabled && Tabs.adjusted;
        tip: Tabs.selection == "" ? "Back to how it fits best" : "These bars back to how they fit best";
        clicked => { Tabs.reset-adjust(); }
    }
}

// Where the bars fall, put right by hand: the time signature, the beat
// twice as fast or half as fast, and the bar lines a beat earlier or later.
component TabBars inherits HorizontalLayout {
    in property <bool> enabled;
    spacing: 4px;
    Text {
        horizontal-stretch: 0;
        text: "Bars";
        color: Theme.text-dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    Dropdown {
        width: 124px;
        list-width: 140px;
        items: Tabs.sigs;
        current: Tabs.sig;
        enabled: root.enabled;
        tip: "The time signature";
        picked(i) => { Tabs.set-sig(i); }
    }
    Rectangle { width: 6px; }
    Text {
        horizontal-stretch: 0;
        text: "Speed";
        color: Theme.text-dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.minus;
        enabled: root.enabled && Tabs.speed > -2;
        tip: "Half as many beats, each twice as long";
        clicked => { Tabs.step-speed(-1); }
    }
    Text {
        width: 26px;
        text: Tabs.speed == 0 ? "×1" : Tabs.speed == 1 ? "×2" : Tabs.speed == 2 ? "×4" : Tabs.speed == -1 ? "½" : "¼";
        color: Tabs.speed != 0 ? Theme.accent : Theme.text-faint;
        font-size: Theme.font-small;
        font-weight: Theme.regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.plus;
        enabled: root.enabled && Tabs.speed < 2;
        tip: "Twice as many beats, each half as long";
        clicked => { Tabs.step-speed(1); }
    }
    Rectangle { width: 6px; }
    Text {
        horizontal-stretch: 0;
        text: "Bar lines";
        color: Theme.text-dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.chevron-left;
        enabled: root.enabled;
        tip: "The bar lines a beat earlier";
        clicked => { Tabs.shift-bars(-1); }
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.chevron-right;
        enabled: root.enabled;
        tip: "The bar lines a beat later";
        clicked => { Tabs.shift-bars(1); }
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 30px;
        icon-size: 14px;
        icon: Icons.refresh-line;
        enabled: root.enabled && Tabs.meter-adjusted;
        tip: "The bars back as found";
        clicked => { Tabs.reset-meter(); }
    }
    Rectangle { width: 6px; }
    Text {
        horizontal-stretch: 1;
        text: Tabs.meter-text;
        color: Theme.text-faint;
        font-size: Theme.font-small;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Mute or solo, on one row of the list of parts.
component MixToggle inherits Rectangle {
    in property <string> letter;
    in property <bool> on;
    in property <color> lit;
    in property <string> tip;
    callback clicked;
    width: 28px;
    height: 24px;
    border-radius: 6px;
    background: root.on ? root.lit : touch.pressed ? Theme.pressed : touch.has-hover ? #ffffff14 : transparent;
    border-width: 1px;
    border-color: root.on ? root.lit : touch.has-hover ? Theme.border-hover : Theme.border-strong;
    Text {
        text: root.letter;
        color: root.on ? #000000 : Theme.text-dim;
        font-size: Theme.font-small - 1px;
        font-weight: Theme.regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tip { text: root.tip; hover: touch.has-hover && !touch.pressed; pressed: touch.pressed; }
}

// The part shown, and the list of every part below it: each with an icon
// for what it plays, and buttons to mute it or solo it. The drums are
// listed to mute and solo, but can't be shown as tab.
component PartDropdown inherits Rectangle {
    in property <bool> enabled: true;
    preferred-width: 160px;
    min-width: 80px;
    height: 34px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.pressed : Theme.surface-3;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? Theme.border-hover : Theme.border-strong;
    opacity: root.enabled || Tabs.parts.length > 0 ? 1 : 0.45;
    property <bool> has: Tabs.part >= 0 && Tabs.part < Tabs.parts.length;
    property <TabPart> shown: Tabs.parts[Tabs.part];
    if root.has: Icon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        line: root.shown.icon-line;
        solid: root.shown.icon-solid;
        weight: 1.6;
        tint: root.shown.audible ? Theme.accent : Theme.text-faint;
    }
    Text {
        x: root.has ? 34px : 12px;
        width: parent.width - self.x - 30px - (Tabs.any-muted ? 18px : 0);
        height: parent.height;
        text: root.has ? root.shown.name : "–";
        color: root.has ? (root.shown.audible ? Theme.accent : Theme.text-dim) : Theme.text-dim;
        font-weight: Theme.regular;
        vertical-alignment: center;
        overflow: elide;
    }
    // Something is muted or soloed.
    if Tabs.any-muted: Rectangle {
        x: parent.width - 42px;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.warn;
    }
    Icon {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        line: Icons.chevron-down;
        weight: 2;
        tint: Theme.text-dim;
    }
    touch := TouchArea {
        enabled: Tabs.parts.length > 0 && !Tabs.busy;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { list.show(); }
    }
    Tip {
        text: "Show another part (channel), or mute and solo the parts";
        hover: touch.has-hover && !touch.pressed;
        pressed: touch.pressed;
    }
    list := PopupWindow {
        close-policy: close-on-click-outside;
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 380px);
        height: min(Tabs.parts.length * 40px + 14px + 36px, 460px);
        Rectangle {
            background: Theme.popup;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000a0;
            VerticalLayout {
                padding: 6px;
                spacing: 0;
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        for p[i] in Tabs.parts: Rectangle {
                            height: 40px;
                            border-radius: 6px;
                            background: row.has-hover && p.pick >= 0 ? #ffffff14 : transparent;
                            row := TouchArea {
                                enabled: p.pick >= 0;
                                mouse-cursor: self.enabled ? pointer : default;
                                // Picked before closing: closing ends the list.
                                clicked => {
                                    Tabs.set-part(p.pick);
                                    list.close();
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 6px;
                                spacing: 8px;
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    width: 16px;
                                    height: 16px;
                                    line: p.pick == Tabs.part ? Icons.check : "";
                                    weight: 2.2;
                                    tint: Theme.paint;
                                }
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    width: 22px;
                                    height: 22px;
                                    line: p.icon-line;
                                    solid: p.icon-solid;
                                    weight: 1.6;
                                    tint: p.audible ? Theme.text : Theme.text-faint;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: p.pick >= 0 ? p.name : p.name + " (no tab)";
                                    color: !p.audible ? Theme.text-faint : p.pick >= 0 ? Theme.text : Theme.text-dim;
                                    font-size: Theme.font-small + 1px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                MixToggle {
                                    y: (parent.height - self.height) / 2;
                                    letter: "M";
                                    on: p.muted;
                                    lit: Theme.danger;
                                    tip: p.muted ? "Let this part back in" : "Mute this part";
                                    clicked => { Tabs.toggle-mute(i); }
                                }
                                MixToggle {
                                    y: (parent.height - self.height) / 2;
                                    letter: "S";
                                    on: p.soloed;
                                    lit: Theme.warn;
                                    tip: p.soloed ? "Take this part out of the solo" : "Solo this part (with any others soloed)";
                                    clicked => { Tabs.toggle-solo(i); }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 36px;
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: Tabs.can-mute ? "M mutes a part, S plays only the parts soloed." : "Muting is heard in MIDI mode (the keyboard button), or for MIDI and tab files.";
                        color: Tabs.can-mute ? Theme.text-faint : Theme.warn;
                        font-size: Theme.font-small - 1px;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                    if Tabs.any-muted: Rectangle {
                        width: 74px;
                        y: (parent.height - 26px) / 2;
                        height: 26px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: clear.has-hover ? Theme.border-hover : Theme.border-strong;
                        background: clear.pressed ? Theme.pressed : transparent;
                        Text {
                            text: "Clear all";
                            color: Theme.text-dim;
                            font-size: Theme.font-small - 1px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        clear := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Tabs.clear-mutes(); }
                        }
                    }
                }
            }
        }
    }
}

// A guitar's neck, the strings across it (the highest on top, as in the
// tab), with the notes of the bar playing on it: the ones sounding now
// lit, the rest dimmed, each with its name.
component Fretboard inherits Rectangle {
    property <int> strings: max(1, Tabs.strings.length);
    property <int> frets: max(1, Tabs.frets);
    property <length> names: 26px;
    // Room left of the nut for open strings.
    property <length> open: 30px;
    property <length> neck-x: root.names + root.open;
    property <length> neck-w: max(100px, root.width - root.neck-x - 8px);
    property <length> fret-w: root.neck-w / root.frets;
    property <length> top: 10px;
    property <length> gap: min(24px, max(16px, (root.height - root.top - 26px) / max(1, root.strings - 1)));
    property <length> neck-h: (root.strings - 1) * root.gap;
    property <length> dot: min(22px, min(root.gap - 1px, root.fret-w - 3px));
    height: root.top + (Tabs.strings.length - 1) * 22px + 28px;
    // The neck.
    Rectangle {
        x: root.neck-x;
        y: root.top - 6px;
        width: root.neck-w;
        height: root.neck-h + 12px;
        border-radius: 4px;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.border;
    }
    // Inlays: one dot at 3, 5, 7, 9, 15, 17, 19 and 21, two at 12 and 24.
    for f in [3, 5, 7, 9, 15, 17, 19, 21]: Rectangle {
        visible: f <= root.frets;
        x: root.neck-x + (f - 0.5) * root.fret-w - 4px;
        y: root.top + root.neck-h / 2 - 4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.border-strong;
    }
    for f in [12, 24]: Rectangle {
        visible: f <= root.frets;
        x: root.neck-x + (f - 0.5) * root.fret-w - 4px;
        y: root.top + root.neck-h / 2 - 4px;
        width: 8px;
        height: 8px;
        Rectangle {
            y: -root.gap * 1.0;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.border-strong;
        }
        Rectangle {
            y: root.gap * 1.0;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.border-strong;
        }
    }
    // The nut, the frets and their numbers.
    Rectangle {
        x: root.neck-x - 2px;
        y: root.top - 6px;
        width: 4px;
        height: root.neck-h + 12px;
        border-radius: 1px;
        background: Theme.text-dim;
    }
    for f[i] in root.frets: Rectangle {
        x: root.neck-x + (i + 1) * root.fret-w - 1px;
        y: root.top - 6px;
        width: 2px;
        height: root.neck-h + 12px;
        background: Theme.border-strong;
        Text {
            x: -root.fret-w / 2 - self.width / 2 + 1px;
            y: parent.height + 3px;
            text: i + 1;
            color: Theme.text-faint;
            font-size: Theme.font-small - 3px;
        }
    }
    // The strings, highest on top, with their names.
    for name[si] in Tabs.strings: Rectangle {
        property <length> sy: root.top + (root.strings - 1 - si) * root.gap;
        Text {
            x: 0;
            y: parent.sy - self.height / 2;
            width: root.names;
            text: name;
            color: Theme.text-faint;
            font-size: Theme.font-small - 1px;
            horizontal-alignment: center;
        }
        Rectangle {
            x: root.names + 6px;
            y: parent.sy - self.height / 2;
            width: root.width - root.names - 14px;
            height: si < 2 ? 2px : 1px;
            background: Theme.text-faint;
        }
    }
    // The notes: on the fret (or left of the nut, open), each named.
    for d in Tabs.fret-dots: Rectangle {
        property <length> cx: d.fret == 0 ? root.names + root.open / 2 : root.neck-x + (d.fret - 0.5) * root.fret-w;
        x: self.cx - self.width / 2;
        y: root.top + (root.strings - 1 - d.string) * root.gap - self.height / 2;
        width: root.dot;
        height: root.dot;
        border-radius: self.width / 2;
        background: d.now ? Theme.paint : #3a3a42;
        border-width: 1px;
        border-color: d.now ? Theme.paint-a : Theme.border-strong;
        Text {
            text: d.name;
            color: d.now ? Theme.on-paint : Theme.text-dim;
            font-size: d.name.character-count > 1 ? root.dot * 0.48 : root.dot * 0.58;
            font-weight: Theme.regular;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A tuning of the player's own: started from any of the tunings, then
// every string a half step up or down, a string more or fewer at either
// end, and (below) each string on its own.
component TabTuning inherits VerticalLayout {
    in property <bool> enabled;
    spacing: 2px;
    HorizontalLayout {
        height: 34px;
        spacing: 4px;
        Text {
            horizontal-stretch: 0;
            text: "Tuning";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        Dropdown {
            width: 150px;
            list-width: 260px;
            items: Tabs.custom-bases;
            current: -1;
            placeholder: "Start from…";
            enabled: root.enabled;
            tip: "Start again from another tuning";
            picked(i) => { Tabs.custom-from(i); }
        }
        Rectangle { width: 6px; }
        Text {
            horizontal-stretch: 0;
            text: "All strings";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.minus;
            enabled: root.enabled;
            tip: "Every string a half step lower";
            clicked => { Tabs.custom-shift(-1); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.plus;
            enabled: root.enabled;
            tip: "Every string a half step higher";
            clicked => { Tabs.custom-shift(1); }
        }
        Rectangle { width: 6px; }
        Text {
            horizontal-stretch: 0;
            text: "Low string";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.minus;
            enabled: root.enabled && Tabs.custom-strings.length > 1;
            tip: "Take the lowest string off";
            clicked => { Tabs.custom-remove(false); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.plus;
            enabled: root.enabled && Tabs.custom-strings.length < Tabs.max-strings;
            tip: "A string more below the lowest, a fourth down";
            clicked => { Tabs.custom-add(false); }
        }
        Rectangle { width: 6px; }
        Text {
            horizontal-stretch: 0;
            text: "High string";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.minus;
            enabled: root.enabled && Tabs.custom-strings.length > 1;
            tip: "Take the highest string off";
            clicked => { Tabs.custom-remove(true); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.plus;
            enabled: root.enabled && Tabs.custom-strings.length < Tabs.max-strings;
            tip: "A string more above the highest, a fourth up";
            clicked => { Tabs.custom-add(true); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    // Each string, lowest first: a half step down or up.
    HorizontalLayout {
        height: 30px;
        spacing: 6px;
        alignment: start;
        Text {
            horizontal-stretch: 0;
            text: "Strings";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        for name[i] in Tabs.custom-strings: Rectangle {
            width: 86px;
            border-radius: 8px;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: 2px;
                padding-right: 2px;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    size: 24px;
                    icon-size: 12px;
                    icon: Icons.chevron-down;
                    enabled: root.enabled;
                    tip: "This string a half step lower";
                    clicked => { Tabs.custom-shift-string(i, -1); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: name;
                    color: Theme.text;
                    font-size: Theme.font-small;
                    font-weight: Theme.regular;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    size: 24px;
                    icon-size: 12px;
                    icon: Icons.chevron-up;
                    enabled: root.enabled;
                    tip: "This string a half step higher";
                    clicked => { Tabs.custom-shift-string(i, 1); }
                }
            }
        }
    }
}

export component TabsSheet inherits Sheet {
    heading: Tabs.title;
    icon: Icons.guitar-line;
    open: Tabs.shown;
    close => { Tabs.close(); }
    property <length> gap: 15px;
    // What the lines show: the tab, standard notation, or both (the staff
    // above the tab).
    property <bool> show-tab: Tabs.notation != 1;
    property <bool> show-staff: Tabs.notation != 0;
    // The staff: a space between its lines, where its top and bottom lines
    // are in a line (with room above for high notes and the line's time),
    // and where its room below ends.
    property <length> sp: 8px;
    property <length> staff-top: 28px + 4 * root.sp;
    property <length> staff-bottom: root.staff-top + 4 * root.sp;
    property <length> staff-end: root.staff-bottom + 5 * root.sp;
    // A note head's width.
    property <length> head-w: 11px;
    // The tab's top and bottom strings.
    property <length> tab-top: root.show-staff ? root.staff-end + 12px : 28px;
    property <length> tab-bottom: root.tab-top + (Tabs.strings.length - 1) * root.gap;
    // From the top of what a line shows to its bottom.
    property <length> content-top: root.show-staff ? root.staff-top : root.tab-top;
    property <length> content-bottom: root.show-tab ? root.tab-bottom : root.staff-bottom;
    // A line: its time on top, clear of the numbers on the top string.
    property <length> line-height: root.show-tab ? root.tab-bottom + 20px : root.staff-end + 4px;
    property <length> label-width: 26px;
    property <length> left: root.label-width + 6px;
    // Across a line, for the notes: what the scroll shows, less the
    // names of the strings and room for its bar.
    property <length> span: max(100px, scroll.visible-width - root.left - 18px);
    // A fret number and its padding, the unit the lines are laid out in
    // (a two-digit number takes two).
    property <length> digit: 11px;
    property <int> digits: floor(root.span / root.digit);
    changed digits => { Tabs.set-width(root.digits); }
    init => { Tabs.set-width(root.digits); }
    // Follows playback, or (when the part changes) stays on the bars that
    // were in view: one handler, so the two can't fight.
    property <int> follow: Tabs.current + Tabs.keep * 65536;
    property <int> kept: 0;
    property <bool> jump;
    property <float> view-top: -scroll.viewport-y / root.line-height;
    changed view-top => { Tabs.top-line = root.view-top; }
    changed follow => {
        if Tabs.keep != root.kept {
            root.kept = Tabs.keep;
            root.jump = true;
            scroll.viewport-y = -max(0, min(Tabs.keep-line * root.line-height, Tabs.lines.length * root.line-height - scroll.visible-height));
        } else if Tabs.current >= 0 {
            root.jump = false;
            scroll.viewport-y = -max(0, min(Tabs.current * root.line-height - scroll.visible-height / 4, Tabs.lines.length * root.line-height - scroll.visible-height));
        }
    }
    HorizontalLayout {
        spacing: 8px;
        height: 34px;
        Text {
            text: "Part";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.chevron-left;
            enabled: Tabs.part-names.length > 1 && !Tabs.busy;
            tip: "The previous part (channel)";
            clicked => { Tabs.step-part(-1); }
        }
        PartDropdown {
            horizontal-stretch: 3;
            enabled: Tabs.parts.length > 0 && !Tabs.busy;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 30px;
            icon-size: 14px;
            icon: Icons.chevron-right;
            enabled: Tabs.part-names.length > 1 && !Tabs.busy;
            tip: "The next part (channel)";
            clicked => { Tabs.step-part(1); }
        }
        Dropdown {
            horizontal-stretch: 1;
            preferred-width: 90px;
            items: Tabs.merge-items;
            current: -1;
            placeholder: "Merge…";
            enabled: Tabs.merge-items.length > 0 && !Tabs.busy;
            tip: "Read this part and another as one: for a tune split across channels (to pan it, or to let its notes ring on)";
            picked(i) => { Tabs.merge(i); }
        }
        Rectangle { width: 8px; }
        Text {
            text: "For";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        Dropdown {
            horizontal-stretch: 2;
            items: Tabs.tunings;
            current: Tabs.tuning;
            enabled: !Tabs.busy && Tabs.part-names.length > 0;
            tip: "Another instrument or tuning";
            picked(i) => { Tabs.set-tuning(i); }
        }
        if !root.compact: Rectangle { width: 8px; }
        if !root.compact: TabAdjust {
            enabled: !Tabs.busy && Tabs.lines.length > 0;
        }
    }
    if root.compact: TabAdjust {
        height: 34px;
        alignment: center;
        enabled: !Tabs.busy && Tabs.lines.length > 0;
    }
    if Tabs.custom: TabTuning {
        enabled: !Tabs.busy && Tabs.part-names.length > 0;
    }
    if Tabs.has-bars: TabBars {
        height: 34px;
        enabled: !Tabs.busy && Tabs.lines.length > 0;
    }
    if Tabs.fretboard-shown && !Tabs.busy && Tabs.lines.length > 0: Fretboard { }
    Rectangle {
        vertical-stretch: 1;
        scroll := ScrollView {
            visible: !Tabs.busy;
            animate viewport-y { duration: root.jump ? 0ms : 350ms; easing: ease-in-out; }
            VerticalLayout {
                for line[li] in Tabs.lines: row := Rectangle {
                    height: root.line-height;
                    property <bool> now: li == Tabs.current;
                    property <length> top: root.tab-top;
                    border-radius: 8px;
                    background: self.now ? Theme.surface-2 : transparent;
                    Text {
                        x: root.left;
                        y: 2px;
                        text: line.start;
                        color: row.now ? Theme.accent : Theme.text-faint;
                        font-size: Theme.font-small - 1px;
                    }
                    // ---- standard notation: the staff, its clef, and the
                    // notes where the tab has them.
                    if root.show-staff: Rectangle {
                        for k in 5: Rectangle {
                            x: root.left;
                            y: root.staff-top + k * root.sp;
                            width: root.span + 10px;
                            height: 1px;
                            background: Theme.border-strong;
                        }
                        Rectangle {
                            x: root.left;
                            y: root.staff-top;
                            width: 2px;
                            height: 4 * root.sp + 1px;
                            background: Theme.border-strong;
                        }
                        // The clef's art has the staff's lines 3 apart
                        // from 6 to 18 on its grid of 24.
                        Icon {
                            x: 4px + root.label-width / 2 - self.width / 2;
                            y: root.staff-top - 2 * root.sp;
                            width: 8 * root.sp;
                            height: 8 * root.sp;
                            line: Tabs.bass-clef ? Icons.clef-bass-line : Icons.clef-treble-line;
                            solid: Tabs.bass-clef ? Icons.clef-bass-solid : Icons.clef-treble-solid;
                            weight: 1.3;
                            tint: Theme.text-dim;
                        }
                        for bar in line.bars: Rectangle {
                            if bar.line && bar.x0 > 0: Rectangle {
                                x: root.left + bar.x0 * root.digits * root.digit - 1px;
                                y: root.staff-top;
                                width: 2px;
                                height: 4 * root.sp + 1px;
                                background: Theme.text-faint;
                            }
                        }
                        for h in line.heads: Rectangle {
                            property <length> cx: root.left + h.x * root.digits * root.digit;
                            property <length> hx: self.cx + h.side * (root.head-w - 1px);
                            property <length> cy: root.staff-bottom - h.pos * root.sp / 2;
                            property <color> ink: h.soft ? Theme.text-dim : Theme.text;
                            // Ledger lines, below the staff and above it.
                            for k in (h.pos <= -2 ? floor(-h.pos / 2) : h.pos >= 10 ? floor((h.pos - 8) / 2) : 0): Rectangle {
                                x: parent.hx - root.head-w / 2 - 4px;
                                y: h.pos < 0 ? root.staff-bottom + (k + 1) * root.sp : root.staff-top - (k + 1) * root.sp;
                                width: root.head-w + 8px;
                                height: 1px;
                                background: Theme.text-dim;
                            }
                            Rectangle {
                                x: parent.hx - root.head-w / 2;
                                y: parent.cy - root.sp / 2;
                                width: root.head-w;
                                height: root.sp;
                                border-radius: root.sp / 2;
                                transform-rotation: -20deg;
                                background: h.hollow ? transparent : parent.ink;
                                border-width: h.hollow ? 1.6px : 0px;
                                border-color: parent.ink;
                            }
                            // Sharp, flat or natural, left of the chord;
                            // their art is centred on 12 of 24, a staff
                            // space 6 of it, and ends at 17.
                            if h.accidental > 0: Icon {
                                x: parent.cx - root.head-w / 2 - (h.side < 0 ? root.head-w : 0px) - self.width * 0.78;
                                y: parent.cy - self.height / 2;
                                width: 4 * root.sp;
                                height: self.width;
                                line: h.accidental == 1 ? Icons.sharp-line : h.accidental == 2 ? Icons.flat-line : Icons.natural-line;
                                weight: 1.5;
                                tint: parent.ink;
                            }
                            // A dot: in the space above a head on a line.
                            if h.dotted: Rectangle {
                                x: parent.hx + root.head-w / 2 + 3px;
                                y: parent.cy - (mod(h.pos, 2) == 0 ? root.sp / 2 : 0px) - 2px;
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: parent.ink;
                            }
                        }
                        for st in line.stems: Rectangle {
                            property <length> cx: root.left + st.x * root.digits * root.digit;
                            property <length> low-y: root.staff-bottom - st.low * root.sp / 2;
                            property <length> high-y: root.staff-bottom - st.high * root.sp / 2;
                            property <length> top-y: st.up ? self.high-y - 3.5 * root.sp : self.high-y;
                            property <length> bottom-y: st.up ? self.low-y : self.low-y + 3.5 * root.sp;
                            property <length> stem-x: st.up ? self.cx + root.head-w / 2 - 1.5px : self.cx - root.head-w / 2;
                            if st.stem: Rectangle {
                                x: parent.stem-x;
                                y: parent.top-y;
                                width: 1.5px;
                                height: parent.bottom-y - parent.top-y;
                                background: Theme.text;
                            }
                            // Flags, curling away from the end of the stem.
                            for f in (st.stem ? st.flags : 0): Icon {
                                x: parent.stem-x - 1px;
                                y: st.up ? parent.top-y - 1px + f * 1.2 * root.sp : parent.bottom-y - self.height + 1px - f * 1.2 * root.sp;
                                width: 3 * root.sp;
                                height: 3 * root.sp;
                                line: st.up ? Icons.flag-up-line : Icons.flag-down-line;
                                weight: 2.2;
                                tint: Theme.text;
                            }
                        }
                    }
                    // ---- the tab: the strings, highest on top, with their
                    // names, and the frets.
                    if root.show-tab: Rectangle {
                        for name[si] in Tabs.strings: Rectangle {
                            property <length> sy: row.top + (Tabs.strings.length - 1 - si) * root.gap;
                            Text {
                                x: 4px;
                                y: parent.sy - self.height / 2;
                                width: root.label-width;
                                text: name;
                                color: Theme.text-faint;
                                font-size: Theme.font-small - 1px;
                                horizontal-alignment: center;
                            }
                            Rectangle {
                                x: root.left;
                                y: parent.sy;
                                width: root.span + 10px;
                                height: 1px;
                                background: Theme.border-strong;
                            }
                        }
                        Rectangle {
                            x: root.left;
                            y: row.top;
                            width: 2px;
                            height: (Tabs.strings.length - 1) * root.gap + 1px;
                            background: Theme.border-strong;
                        }
                        for c in line.cells: Rectangle {
                            x: root.left + c.x * root.digits * root.digit - self.width / 2;
                            y: row.top + (Tabs.strings.length - 1 - c.string) * root.gap - self.height / 2;
                            width: fret.preferred-width + 6px;
                            height: 15px;
                            background: row.now ? Theme.surface-2 : Theme.bg;
                            fret := Text {
                                text: c.fret;
                                color: c.soft ? Theme.text-dim : Theme.text;
                                font-size: Theme.font-small;
                                font-weight: Theme.regular;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        for bar in line.bars: Rectangle {
                            if bar.line && bar.x0 > 0: Rectangle {
                                x: root.left + bar.x0 * root.digits * root.digit - 1px;
                                y: row.top;
                                width: 2px;
                                height: (Tabs.strings.length - 1) * root.gap + 1px;
                                background: Theme.text-faint;
                            }
                        }
                    }
                    // The bars' numbers, and the chosen bars marked above
                    // and below what the line shows.
                    for bar in line.bars: Rectangle {
                        property <length> x0: root.left + bar.x0 * root.digits * root.digit;
                        property <length> x1: root.left + bar.x1 * root.digits * root.digit;
                        Text {
                            x: parent.x0 + (bar.x0 > 0 ? 3px : 44px);
                            y: 3px;
                            text: bar.label;
                            color: bar.selected || bar.nudged ? Theme.accent : Theme.text-faint;
                            font-size: Theme.font-small - 2px;
                        }
                        if bar.selected: Rectangle {
                            x: parent.x0 + 2px;
                            y: root.content-top - 9px;
                            width: parent.x1 - parent.x0 - 4px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.paint;
                        }
                        if bar.selected: Rectangle {
                            x: parent.x0 + 2px;
                            y: root.content-bottom + 7px;
                            width: parent.x1 - parent.x0 - 4px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.paint;
                        }
                    }
                    if row.now: Rectangle {
                        x: root.left + Tabs.playhead * root.digits * root.digit - 1px;
                        y: root.content-top - 8px;
                        width: 2px;
                        height: root.content-bottom - root.content-top + 16px;
                        background: Theme.paint;
                        border-radius: 1px;
                    }
                    // Clicks: a bar plays from its start (Ctrl-click
                    // chooses it, Shift-click the bars up to it); a note,
                    // from the note.
                    if line.bars.length == 0: TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Tabs.seek-line(li); }
                    }
                    for bar in line.bars: TouchArea {
                        property <bool> shift;
                        property <bool> ctrl;
                        x: root.left + bar.x0 * root.digits * root.digit;
                        width: (bar.x1 - bar.x0) * root.digits * root.digit;
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                self.shift = e.modifiers.shift;
                                self.ctrl = e.modifiers.control || e.modifiers.meta;
                            }
                        }
                        clicked => {
                            if self.shift || self.ctrl {
                                Tabs.select-bar(bar.index, self.shift);
                            } else {
                                Tabs.seek-bar(bar.index);
                            }
                        }
                    }
                    if root.show-tab: Rectangle {
                        for c in line.cells: TouchArea {
                            property <bool> shift;
                            property <bool> ctrl;
                            x: root.left + c.x * root.digits * root.digit - self.width / 2;
                            y: row.top + (Tabs.strings.length - 1 - c.string) * root.gap - self.height / 2;
                            width: 20px;
                            height: root.gap;
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    self.shift = e.modifiers.shift;
                                    self.ctrl = e.modifiers.control || e.modifiers.meta;
                                }
                            }
                            clicked => {
                                if (self.shift || self.ctrl) && c.bar >= 0 {
                                    Tabs.select-bar(c.bar, self.shift);
                                } else {
                                    Tabs.seek-to(c.ms);
                                }
                            }
                        }
                    }
                    if root.show-staff: Rectangle {
                        for st in line.stems: TouchArea {
                            property <bool> shift;
                            property <bool> ctrl;
                            property <length> low-y: root.staff-bottom - st.low * root.sp / 2;
                            property <length> high-y: root.staff-bottom - st.high * root.sp / 2;
                            x: root.left + st.x * root.digits * root.digit - self.width / 2;
                            y: self.high-y - root.sp;
                            width: root.head-w + 8px;
                            height: self.low-y - self.high-y + 2 * root.sp;
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    self.shift = e.modifiers.shift;
                                    self.ctrl = e.modifiers.control || e.modifiers.meta;
                                }
                            }
                            clicked => {
                                if (self.shift || self.ctrl) && st.bar >= 0 {
                                    Tabs.select-bar(st.bar, self.shift);
                                } else {
                                    Tabs.seek-to(st.ms);
                                }
                            }
                        }
                    }
                }
            }
        }
        if Tabs.busy || Tabs.lines.length == 0: Text {
            x: 24px;
            width: parent.width - 48px;
            height: parent.height;
            text: Tabs.busy ? "Working out the notes…" : Tabs.message;
            color: Theme.text-dim;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: Tabs.detail;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
        copier := TextInput {
            width: 0px;
            height: 0px;
            opacity: 0;
            read-only: true;
            text: Tabs.all-text;
        }
        if Tabs.lines.length > 0: Dropdown {
            width: 150px;
            list-width: 170px;
            items: ["Tab", "Notation", "Tab and notation"];
            current: Tabs.notation;
            tip: "Show the tab, standard notation (the staff), or both";
            picked(i) => { Tabs.notation = i; }
        }
        if Tabs.lines.length > 0: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.fretboard-line;
            icon-solid: Icons.fretboard-solid;
            active: Tabs.fretboard-shown;
            tip: Tabs.fretboard-shown ? "Hide the fretboard" : "Show the fretboard: the notes playing, and the rest of the bar's";
            clicked => { Tabs.fretboard-shown = !Tabs.fretboard-shown; }
        }
        if Tabs.lines.length > 0: BigButton {
            text: "Copy";
            tip: "Copy the tab as text";
            clicked => { copier.select-all(); copier.copy(); copier.clear-selection(); }
        }
        if Tabs.lines.length > 0 && Tabs.has-bars: BigButton {
            text: "Save…";
            tip: "Save every part as tab in bars: MusicXML (sheet music and tab) or Guitar Pro";
            clicked => { Tabs.save(); }
        }
    }
}
