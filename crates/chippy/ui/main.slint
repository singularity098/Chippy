// Chippy's main window.
//
// Layout: a slim title bar on top (gone in fullscreen), the playlist and
// the large album art in the middle, the bottom bar with the transport.
// The file browser slides in from the left edge and the settings from the
// right (as Carlita's sidebars do): rest the mouse on the edge, swipe in,
// or tap the edge's tab. A panel brought in by hovering goes again when the
// mouse leaves it, unless something in it was used; then it stays until a
// click outside it or its close button.
//
// On a phone held upright (Theme.mobile, taller than wide) the middle and
// the bottom bar give way to the phone's player (phone.slint), and the
// playlist becomes a page of its own that slides up over it.
import "../../../assets/fonts/Jost-Light.ttf";
import "../../../assets/fonts/Jost-Regular.ttf";
import { Theme, ThemeLook } from "theme.slint";
import { IconButton, Tips } from "widgets.slint";
import { Icon, Icons, IconArt } from "icons.slint";
import { TooltipLayer } from "tooltip.slint";
import { FileItem, PlRow, ColumnItem, Crumb, InfoField, MusicDir } from "types.slint";
import { Browser, BrowserPanel } from "browser.slint";
import { Playlist, PlaylistPanel } from "playlist.slint";
import { Now, ArtPanel, BottomBar } from "nowplaying.slint";
import { Prefs, SettingsPanel } from "settings.slint";
import { Info, Export, Lyrics, Tabs, TabCell, TabLine, TabBar, TabPart, FretDot, StaffHead, StaffStem, InfoDialog, ExportDialog, LyricsSheet, TabsSheet } from "dialogs.slint";
import { PhoneTopBar, PhonePlayer, QueuePage } from "phone.slint";

export { Theme, IconArt, Browser, Playlist, Now, Prefs, Info, Export, Lyrics, Tabs, TabCell, TabLine, TabBar, TabPart, FretDot, StaffHead, StaffStem, FileItem, PlRow, ColumnItem, Crumb, InfoField, MusicDir }

// A window edge that brings in a sidebar: follows the finger and snaps
// open or closed, opens on a tap, and shows a tab while the mouse is over it.
component EdgeStrip inherits Rectangle {
    in property <bool> right-side;
    in property <length> panel-width;
    in property <string> icon;
    callback drag(float);
    callback release(bool);
    callback tap;
    callback hover;
    out property <bool> hovered: self.visible && (strip.has-hover || tab-touch.has-hover);
    property <float> amount: 0;

    // A moment's rest, so the pointer passing the edge does not open it.
    Timer {
        interval: 60ms;
        running: root.hovered && !strip.pressed && !tab-touch.pressed;
        triggered => { root.hover(); }
    }
    tab := Rectangle {
        visible: strip.has-hover || tab-touch.has-hover;
        width: 40px;
        height: 110px;
        x: root.right-side ? root.width - self.width : 0;
        y: (root.height - self.height) / 2;
        border-radius: 10px;
        background: tab-touch.pressed ? Theme.paint : #00000080;
        border-width: 1px;
        border-color: tab-touch.pressed ? transparent : Theme.border-hover;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            line: root.icon;
            weight: 1.8;
            tint: tab-touch.pressed ? Theme.on-paint : Theme.text;
        }
        tab-touch := TouchArea { clicked => { root.tap(); } }
    }
    strip := TouchArea {
        width: root.width;
        x: 0;
        moved => {
            root.amount = max(0, min(1, (root.right-side ? self.pressed-x - self.mouse-x : self.mouse-x - self.pressed-x) / root.panel-width));
            root.drag(root.amount);
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if abs(self.mouse-x - self.pressed-x) < 4px && e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    root.tap();
                } else {
                    root.release(root.amount > 0.33);
                }
                root.amount = 0;
            }
        }
    }
}

component ResizeHandle inherits TouchArea {
    in property <string> direction;
    callback start(string);
    mouse-cursor: root.direction == "n" || root.direction == "s" ? ns-resize
        : root.direction == "e" || root.direction == "w" ? ew-resize
        : root.direction == "nw" || root.direction == "se" ? nwse-resize
        : nesw-resize;
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.start(root.direction);
        }
    }
}

component TopBar inherits Rectangle {
    in property <bool> maximized;
    // Shown over a fullscreen window: no moving, minimising or maximising.
    in property <bool> fullscreen;
    in property <string> subtitle;
    callback start-drag;
    callback toggle-maximize;
    callback minimize;
    callback close-window;
    callback toggle-fullscreen;
    callback open-settings;
    callback open-browser;
    background: #00000066;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    // Dragging the bar's empty parts moves the window; double-clicking
    // maximises or restores it. The window manager is handed the drag only
    // once the pointer moves: taken at the press, it would swallow the
    // second click of a double-click.
    TouchArea {
        property <bool> armed;
        pointer-event(e) => {
            if e.button == PointerEventButton.left {
                if e.kind == PointerEventKind.down { self.armed = true; }
                if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { self.armed = false; }
            }
        }
        moved => {
            if self.armed && self.pressed && (abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px) {
                self.armed = false;
                root.start-drag();
            }
        }
        double-clicked => { self.armed = false; root.toggle-maximize(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 4px;
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 34px;
            icon: Icons.menu-line;
            tip: "File browser";
            clicked => { root.open-browser(); }
        }
        if !Theme.mobile: IconButton {
            y: (parent.height - self.height) / 2;
            size: 34px;
            icon-size: 18px;
            icon: Icons.open-line;
            weight: 1.6;
            tip: "Open a file (Ctrl+O)";
            clicked => { Playlist.open-file(); }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 22px;
            line: Icons.chip-iso-line;
            weight: 1.6;
            tint: Theme.paint;
        }
        Text {
            text: "Chippy";
            font-size: Theme.font + 1px;
            font-weight: Theme.regular;
            letter-spacing: 1px;
            color: Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: root.subtitle;
            font-size: Theme.font-small;
            color: Theme.text-faint;
            vertical-alignment: center;
            horizontal-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        IconButton { y: (parent.height - self.height) / 2; size: 34px; icon-size: 18px; icon: Icons.gear-line; weight: 1.6; tip: "Settings"; clicked => { root.open-settings(); } }
        if !Theme.mobile: IconButton { y: (parent.height - self.height) / 2; size: 34px; icon-size: 18px; icon: root.fullscreen ? Icons.fullscreen-exit-line : Icons.fullscreen-line; tip: root.fullscreen ? "Leave fullscreen (F11)" : "Fullscreen (F11)"; clicked => { root.toggle-fullscreen(); } }
        if !Theme.mobile && !root.fullscreen: IconButton { y: (parent.height - self.height) / 2; size: 34px; icon-size: 18px; icon: Icons.minimize-line; tip: "Minimise"; clicked => { root.minimize(); } }
        if !Theme.mobile && !root.fullscreen: IconButton { y: (parent.height - self.height) / 2; size: 34px; icon-size: 18px; icon: root.maximized ? Icons.restore-line : Icons.maximize-line; weight: 1.6; tip: root.maximized ? "Restore" : "Maximise"; clicked => { root.toggle-maximize(); } }
        if !Theme.mobile: IconButton { y: (parent.height - self.height) / 2; size: 34px; icon-size: 18px; icon: Icons.close; tip: "Quit"; clicked => { root.close-window(); } }
    }
}

export component MainWindow inherits Window {
    title: "Chippy";
    no-frame: true;
    icon: @image-url("../../../assets/chippy-icon.svg");
    background: Theme.bg;
    // Zoomed in, the window may be smaller (in the zoomed pixels), so it
    // still fits on the screen.
    min-width: Theme.mobile ? 0 : 760px / max(1, root.zoom);
    min-height: Theme.mobile ? 0 : 520px / max(1, root.zoom);
    preferred-width: Theme.mobile ? 412px : 1360px;
    preferred-height: Theme.mobile ? 880px : 820px;
    default-font-size: Theme.font;
    default-font-family: "Jost";
    default-font-weight: Theme.light;

    in property <bool> fullscreen;
    in property <bool> window-maximized;
    // How much bigger than the system's size everything is drawn (from Rust).
    in property <float> zoom: 1;
    in property <bool> hover-opens: true;
    in property <[string]> theme-names: Theme.names;
    in-out property <string> toast;
    in property <bool> toast-error;
    in property <string> subtitle;
    // The phone's playlist page is showing.
    in-out property <bool> queue-open;
    // The next track's title, for the phone's "up next" line.
    in property <string> up-next;

    callback start-drag;
    callback start-resize(string);
    callback minimize-window;
    callback toggle-maximize;
    callback close-window;
    callback toggle-fullscreen;
    // Ctrl+plus (1), Ctrl+minus (-1), Ctrl+0 (0); and the system's scale
    // changed (the zoom goes on top of it). Both from Rust.
    callback zoom-by(int);
    callback rescaled;
    callback seek-by(int);
    callback volume-by(float);

    // The edges that bring the sidebars in: as wide as the margin beside the
    // playlist and the art, so they are easy to find without covering them.
    property <length> strip-width: 22px;
    property <length> gutter: 8px;
    property <bool> phone: Theme.mobile && root.height > root.width;
    property <bool> docked: !root.fullscreen && !Theme.mobile;
    property <length> top-inset: root.phone ? 58px : Theme.mobile ? 50px : root.docked ? 44px : 0;
    property <length> bottom-height: root.phone ? 0 : 96px;
    property <length> mid-height: root.height - root.top-inset - root.bottom-height;
    // Where the sidebars go: over everything on a phone, as drawers do.
    property <length> side-top: root.phone ? 0 : root.top-inset;
    property <length> side-height: root.phone ? root.height : root.mid-height;
    property <bool> framed: root.docked && !root.window-maximized;
    property <length> edge-inset: root.framed ? 5px : 0;

    // Sidebars: 0 closed, 1 open.
    in-out property <float> left-pos: 0;
    in-out property <float> right-pos: 0;
    property <bool> left-dragging;
    property <bool> right-dragging;
    property <bool> left-by-hover;
    property <bool> right-by-hover;
    // The title bar over a fullscreen window: 0 hidden, 1 shown. Brought in
    // by resting the mouse on the top edge; goes again when the mouse
    // leaves it, unless it was clicked (then a click elsewhere hides it).
    property <float> top-pos: 0;
    property <bool> top-by-hover;
    property <length> top-bar-height: 44px;
    property <bool> top-pops: root.fullscreen && !Theme.mobile;
    property <length> left-width: min(520px, root.width * 0.9);
    property <length> right-width: min(580px, root.width * 0.92);

    public function open-left() {
        root.left-pos = 1; root.right-pos = 0; root.left-by-hover = false; root.right-by-hover = false;
        browser-panel.focus-list();
    }
    public function close-left() { root.left-pos = 0; root.left-by-hover = false; keys.focus(); }
    public function open-right() { root.right-pos = 1; root.left-pos = 0; root.left-by-hover = false; root.right-by-hover = false; }
    public function close-right() { root.right-pos = 0; root.right-by-hover = false; keys.focus(); }
    public function focus-main() { keys.focus(); }
    public function show-top() { root.top-pos = 1; root.top-by-hover = false; }
    public function hide-top() { root.top-pos = 0; root.top-by-hover = false; }
    public function open-queue() { root.queue-open = true; root.close-left(); root.close-right(); }

    // Android's back button: closes what is on top, and says whether there
    // was anything (if not, the app goes to the background).
    public function back() -> bool {
        if Export.shown { Export.close(); return true; }
        if Info.shown { Info.close(); return true; }
        if Tabs.shown { Tabs.close(); return true; }
        if Lyrics.shown { Lyrics.close(); return true; }
        if root.left-pos > 0 { root.close-left(); return true; }
        if root.right-pos > 0 { root.close-right(); return true; }
        if root.queue-open { root.queue-open = false; return true; }
        return false;
    }

    function over-left(x: length, y: length) -> bool { x < root.left-width && y >= root.top-inset && y < root.top-inset + root.mid-height }
    function over-right(x: length, y: length) -> bool { x >= root.width - root.right-width && y >= root.top-inset && y < root.top-inset + root.mid-height }

    // Every pointer move and press, seen before any element (from Rust).
    public function pointer-moved(x: length, y: length) {
        if root.top-by-hover && root.top-pos > 0 && y > root.top-bar-height + 6px { root.hide-top(); }
        if root.left-by-hover && root.left-pos > 0 && !root.left-dragging && !root.over-left(x, y) { root.close-left(); }
        if root.right-by-hover && root.right-pos > 0 && !root.right-dragging && !root.over-right(x, y) { root.close-right(); }
    }
    public function pointer-pressed(x: length, y: length) {
        if root.top-pos > 0 {
            if y < root.top-bar-height { root.top-by-hover = false; } else if !root.top-by-hover { root.hide-top(); }
        }
        if root.left-by-hover && root.over-left(x, y) { root.left-by-hover = false; }
        if root.right-by-hover && root.over-right(x, y) { root.right-by-hover = false; }
    }

    changed left-pos => { Tips.hide(); }
    changed top-pops => { root.hide-top(); }
    changed right-pos => { Tips.hide(); }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.F11 { root.toggle-fullscreen(); return accept; }
            if e.text == Key.Escape {
                if root.left-pos > 0 { root.close-left(); return accept; }
                if root.right-pos > 0 { root.close-right(); return accept; }
                if root.fullscreen { root.toggle-fullscreen(); return accept; }
                return accept;
            }
            if e.text == " " { Now.play-pause(); return accept; }
            if e.text == Key.LeftArrow && !e.modifiers.alt { root.seek-by(e.modifiers.shift ? -30 : -5); return accept; }
            if e.text == Key.RightArrow && !e.modifiers.alt { root.seek-by(e.modifiers.shift ? 30 : 5); return accept; }
            if e.text == Key.UpArrow { root.volume-by(0.05); return accept; }
            if e.text == Key.DownArrow { root.volume-by(-0.05); return accept; }
            if e.text == "n" { Now.next(); return accept; }
            if e.text == "p" { Now.previous(); return accept; }
            if e.text == "s" { Now.toggle-shuffle(); return accept; }
            if e.text == "r" { Now.cycle-repeat(); return accept; }
            if e.text == "m" { Now.toggle-mute(); return accept; }
            if e.text == "M" { Now.toggle-midi-mode(); return accept; }
            if e.text == "l" { Now.show-lyrics(); return accept; }
            if e.text == "t" { Now.show-tabs(); return accept; }
            if e.text == "[" { Now.cycle-soundfont(-1); return accept; }
            if e.text == "]" { Now.cycle-soundfont(1); return accept; }
            if e.text == "b" || e.text == Key.Tab { root.open-left(); return accept; }
            if e.text == "," { root.open-right(); return accept; }
            if e.modifiers.control && (e.text == "o" || e.text == "O") { Playlist.open-file(); return accept; }
            if e.modifiers.control && (e.text == "f" || e.text == "F") { root.open-left(); browser-panel.focus-search(); return accept; }
            reject
        }
    }

    // ---------------------------------------------------------- main area
    // The lyrics or the guitar tab takes the player's place (on the
    // desktop): the playlist and the art fade out, the page fades in.
    property <bool> page-shown: !root.phone && (Lyrics.shown || Tabs.shown);
    if !root.phone: Rectangle {
        y: root.top-inset;
        height: root.mid-height;
        opacity: root.page-shown ? 0 : 1;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.slide; easing: ease-out; }
        HorizontalLayout {
            padding: 18px;
            padding-left: root.gutter + 14px;
            padding-right: root.gutter + 14px;
            spacing: 22px;
            PlaylistPanel {
                horizontal-stretch: 1;
                min-width: 320px;
                open-browser => { root.open-left(); }
            }
            ArtPanel {
                horizontal-stretch: 0;
                width: min(parent.height - 36px - 80px, (root.width - 2 * root.gutter) * 0.42);
            }
        }
    }

    // The lyrics and the guitar tab: on a phone they slide up over the
    // player; on the desktop they take its place, between the title bar and
    // the bottom bar (and so the transport, still below them).
    property <length> sheet-height: root.phone ? root.height - root.top-inset : root.mid-height;
    property <length> sheet-inset: root.phone ? 0 : root.gutter;
    // Lyrics are seldom long lines: on a wide window, a column in the
    // middle.
    property <length> lyrics-width: root.phone ? root.width : min(root.width - 2 * root.sheet-inset, 760px);
    LyricsSheet {
        x: (root.width - self.width) / 2;
        width: root.lyrics-width;
        height: root.sheet-height;
        y: Lyrics.shown || !root.phone ? root.top-inset : root.height;
        opacity: Lyrics.shown || root.phone ? 1 : 0;
        visible: root.phone ? self.y < root.height : self.opacity > 0;
        animate y { duration: Theme.slide; easing: ease-out; }
        animate opacity { duration: Theme.slide; easing: ease-out; }
        compact: root.phone;
        page: !root.phone;
    }
    TabsSheet {
        x: root.sheet-inset;
        width: root.width - 2 * root.sheet-inset;
        height: root.sheet-height;
        y: Tabs.shown || !root.phone ? root.top-inset : root.height;
        opacity: Tabs.shown || root.phone ? 1 : 0;
        visible: root.phone ? self.y < root.height : self.opacity > 0;
        animate y { duration: Theme.slide; easing: ease-out; }
        animate opacity { duration: Theme.slide; easing: ease-out; }
        compact: root.phone;
        page: !root.phone;
    }

    if !root.phone: BottomBar {
        lyrics-shown: Lyrics.shown;
        tabs-shown: Tabs.shown;
        y: root.height - root.bottom-height;
        height: root.bottom-height;
    }

    if root.phone: PhonePlayer {
        y: root.top-inset;
        height: root.mid-height;
        up-next: root.up-next;
        open-queue => { root.open-queue(); }
        open-browser => { root.open-left(); }
    }

    if root.phone: PhoneTopBar {
        y: 0;
        height: root.top-inset;
        title: "NOW PLAYING";
        open-browser => { root.open-left(); }
        open-queue => { root.open-queue(); }
        open-settings => { root.open-right(); }
    }

    QueuePage {
        y: root.queue-open && root.phone ? 0 : root.height;
        height: root.height;
        visible: root.phone && self.y < root.height;
        animate y { duration: Theme.slide; easing: ease-out; }
        close => { root.queue-open = false; }
        open-browser => { root.open-left(); }
    }

    if (root.docked || Theme.mobile) && !root.phone: TopBar {
        y: 0;
        height: root.top-inset;
        maximized: root.window-maximized;
        subtitle: root.subtitle;
        start-drag => { root.start-drag(); }
        toggle-maximize => { root.toggle-maximize(); }
        minimize => { root.minimize-window(); }
        close-window => { root.close-window(); }
        toggle-fullscreen => { root.toggle-fullscreen(); }
        open-settings => { root.open-right(); }
        open-browser => { root.open-left(); }
    }

    // ----------------------------------------------------------- sidebars
    // On a touch screen an open sidebar follows a swipe back towards its
    // edge and closes, from anywhere on it or beside it (a vertical swipe
    // still scrolls its lists).
    side-swipe := SwipeGestureHandler {
        x: 0;
        y: root.side-top;
        width: root.width;
        height: root.side-height;
        enabled: Theme.mobile && (root.left-pos > 0 || root.right-pos > 0 || root.left-dragging || root.right-dragging);
        handle-swipe-left: root.left-pos > 0 || root.left-dragging;
        handle-swipe-right: (root.right-pos > 0 || root.right-dragging) && !root.left-dragging;
        moved => {
            if !self.swiping { return; }
            if root.left-pos > 0 || root.left-dragging {
                root.left-dragging = true;
                root.left-pos = max(0, min(1, 1 - (self.pressed-position.x - self.current-position.x) / root.left-width));
            } else if root.right-pos > 0 || root.right-dragging {
                root.right-dragging = true;
                root.right-pos = max(0, min(1, 1 - (self.current-position.x - self.pressed-position.x) / root.right-width));
            }
        }
        // Closes once moved a fifth of the way.
        swiped => {
            if root.left-dragging {
                root.left-dragging = false;
                if root.left-pos < 0.8 { root.close-left(); } else { root.left-pos = 1; }
            }
            if root.right-dragging {
                root.right-dragging = false;
                if root.right-pos < 0.8 { root.close-right(); } else { root.right-pos = 1; }
            }
        }
        cancelled => {
            if root.left-dragging { root.left-dragging = false; root.left-pos = 1; }
            if root.right-dragging { root.right-dragging = false; root.right-pos = 1; }
        }

        if root.left-pos > 0 || root.right-pos > 0: Rectangle {
            background: Colors.rgba(0, 0, 0, 0.55 * max(root.left-pos, root.right-pos));
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up {
                        root.close-left();
                        root.close-right();
                    }
                }
            }
        }

        browser-panel := BrowserPanel {
            y: 0;
            width: root.left-width;
            height: root.side-height;
            x: (root.left-pos - 1) * root.left-width;
            visible: root.left-pos > 0;
            animate x { duration: root.left-dragging ? 0ms : Theme.slide; easing: ease-out; }
            close => { root.close-left(); }
            interacted => { root.left-by-hover = false; }
        }

        SettingsPanel {
            y: 0;
            width: root.right-width;
            height: root.side-height;
            x: root.width - root.right-pos * root.right-width;
            visible: root.right-pos > 0;
            animate x { duration: root.right-dragging ? 0ms : Theme.slide; easing: ease-out; }
            theme-names: root.theme-names;
            close => { root.close-right(); }
            interacted => { root.right-by-hover = false; }
        }
    }

    left-strip := EdgeStrip {
        visible: root.left-pos == 0 || root.left-dragging;
        x: root.edge-inset;
        y: root.top-inset;
        width: root.strip-width - root.edge-inset;
        height: root.mid-height;
        icon: Icons.folder-line;
        panel-width: root.left-width;
        drag(a) => { root.left-dragging = true; root.right-pos = 0; root.left-pos = a; }
        release(open) => {
            root.left-dragging = false;
            if open { root.open-left(); } else { root.close-left(); }
        }
        tap => { root.open-left(); }
        hover => {
            if root.hover-opens && root.left-pos == 0 && root.right-pos == 0 {
                root.open-left();
                root.left-by-hover = true;
            }
        }
    }
    right-strip := EdgeStrip {
        visible: root.right-pos == 0 || root.right-dragging;
        x: root.width - root.strip-width;
        y: root.top-inset;
        width: root.strip-width - root.edge-inset;
        height: root.mid-height;
        right-side: true;
        icon: Icons.gear-line;
        panel-width: root.right-width;
        drag(a) => { root.right-dragging = true; root.left-pos = 0; root.right-pos = a; }
        release(open) => {
            root.right-dragging = false;
            if open { root.open-right(); } else { root.close-right(); }
        }
        tap => { root.open-right(); }
        hover => {
            if root.hover-opens && root.left-pos == 0 && root.right-pos == 0 {
                root.open-right();
                root.right-by-hover = true;
            }
        }
    }

    // ------------------------------------- the title bar over fullscreen
    if root.top-pops && root.top-pos == 0: TouchArea {
        x: root.strip-width;
        y: 0;
        width: root.width - 2 * root.strip-width;
        height: 6px;
        // A moment's rest, so the pointer passing the edge does not open it.
        Timer {
            interval: 60ms;
            running: parent.has-hover && !parent.pressed;
            triggered => {
                root.show-top();
                root.top-by-hover = true;
            }
        }
        clicked => { root.show-top(); }
    }
    if root.top-pops: TopBar {
        y: (root.top-pos - 1) * root.top-bar-height;
        height: root.top-bar-height;
        visible: root.top-pos > 0 || self.y > -root.top-bar-height;
        animate y { duration: Theme.slide; easing: ease-out; }
        background: Theme.bg.with-alpha(0.92);
        fullscreen: true;
        subtitle: root.subtitle;
        toggle-fullscreen => { root.toggle-fullscreen(); }
        close-window => { root.close-window(); }
        open-settings => { root.hide-top(); root.open-right(); }
        open-browser => { root.hide-top(); root.open-left(); }
    }

    // ---------------------------------------------------------- the toast
    if root.toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - root.bottom-height - self.height - (root.phone ? 84px : 16px);
        width: min(root.width - 40px, toast-text.preferred-width + 40px);
        height: 44px;
        border-radius: 22px;
        background: Theme.popup;
        border-width: 1px;
        border-color: root.toast-error ? Theme.danger : Theme.border-strong;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000a0;
        toast-text := Text {
            text: root.toast;
            color: root.toast-error ? Theme.danger.brighter(40%) : Theme.text;
            font-size: Theme.font-small + 1px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea { clicked => { root.toast = ""; } }
    }

    // ------------------------------------------------- window border handles
    if root.framed: Rectangle {
        property <length> b: root.edge-inset;
        property <length> c: 14px;
        ResizeHandle { direction: "n"; x: parent.c; y: 0; width: root.width - 2 * parent.c; height: parent.b; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "s"; x: parent.c; y: root.height - parent.b; width: root.width - 2 * parent.c; height: parent.b; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "w"; x: 0; y: parent.c; width: parent.b; height: root.height - 2 * parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "e"; x: root.width - parent.b; y: parent.c; width: parent.b; height: root.height - 2 * parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "nw"; x: 0; y: 0; width: parent.c; height: parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "ne"; x: root.width - parent.c; y: 0; width: parent.c; height: parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "sw"; x: 0; y: root.height - parent.c; width: parent.c; height: parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "se"; x: root.width - parent.c; y: root.height - parent.c; width: parent.c; height: parent.c; start(d) => { root.start-resize(d); } }
    }

    if Info.shown: InfoDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }
    if Export.shown: ExportDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    TooltipLayer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    if Theme.scanlines: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: @image-url("../../../assets/scanlines.png");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        accessible-role: none;
    }
}
