// Data handed to the UI from Rust.

// One row of the file browser.
export struct FileItem {
    // The name without its extension, and the extension (drawn dimmer).
    stem: string,
    ext: string,
    // 0 folder, 1 archive, 2 music file, 3 music file that may hold several
    // tracks, 4 track of a multi-track file, 5 image, 6 other file.
    kind: int,
    // Right-aligned detail (a track's length, a file's size).
    detail: string,
    // The track playing now.
    playing: bool,
}

// One playlist row: the text of each visible column, in order.
export struct PlRow {
    cells: [string],
    playing: bool,
    // Metadata not read yet (shown dimmer).
    pending: bool,
    // For the phone's playlist: the title, and "artist · length" under it.
    title: string,
    detail: string,
}

export struct ColumnItem {
    id: string,
    title: string,
    width: length,
    visible: bool,
    // Right-aligned (numbers, lengths).
    right: bool,
}

// One level of the folder shown, in the browser's path bar.
export struct Crumb {
    label: string,
    // The virtual path to go to.
    path: string,
    // Drawn after a "/".
    sep: bool,
}

// One line of a track's properties dialog.
export struct InfoField {
    label: string,
    value: string,
}

// One of the music folders.
export struct MusicDir {
    // The folder's name, and its path with the home folder as "~".
    label: string,
    path: string,
    // The file browser's home (its home button).
    home: bool,
    // The file browser is in this folder now.
    current: bool,
}
